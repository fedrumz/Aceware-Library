-- newDropdown
-- FIX: row height 30→36
-- ─────────────────────────────────────────────────────────────────────────────
function AxewareLib.Content:newDropdown(title, callback, list, noCallbackOnStart)
    local oldSize

    local btn                          = Instance.new("TextButton")
    btn.BackgroundColor3               = C.white
    btn.BackgroundTransparency         = 1
    btn.BorderSizePixel                = 0
    btn.Size                           = ud2(1, 0, 0, 36)    -- FIX: 30 → 36
    btn.Text                           = ""
    btn.Parent                         = self.bodyFrame
    

    local titleLbl                     = Instance.new("TextLabel")
    titleLbl.BackgroundTransparency    = 1
    titleLbl.Position                  = ud2(0, 10, 0, 0)
    titleLbl.Size                      = ud2(1, -30, 1, 0)
    titleLbl.Font                      = Enum.Font.Gotham
    titleLbl.TextSize                  = 14    -- FIX: 13 → 14
    titleLbl.TextColor3                = C.textMain
    titleLbl.TextXAlignment            = Enum.TextXAlignment.Left
    titleLbl.Text                      = title
    titleLbl.Parent                    = btn

    local arrow                        = Instance.new("TextLabel")
    arrow.BackgroundTransparency       = 1
    arrow.Position                     = ud2(1, -20, 0, 0)
    arrow.Size                         = ud2(0, 16, 1, 0)
    arrow.Font                         = Enum.Font.GothamBold
    arrow.TextSize                     = 10
    arrow.TextColor3                   = C.textGrey
    arrow.Text                         = "v"
    arrow.Rotation                     = 180
    arrow.Parent                       = btn

    local panel                        = Instance.new("Frame")
    panel.BackgroundColor3             = C.dropdown
    panel.BorderSizePixel              = 0
    panel.Position                     = ud2(0, 0, 1, 0)
    panel.Size                         = ud2(1, 0, 0, 0)
    panel.ClipsDescendants             = true
    panel.ZIndex                       = 5
    panel.Visible                      = false
    panel.Parent                       = btn

    local panelLayout                  = Instance.new("UIListLayout")
    panelLayout.SortOrder              = Enum.SortOrder.LayoutOrder
    panelLayout.Parent                 = panel

    local arrowOpen  = tweenSvc:Create(arrow, TweenInfo.new(0.2), { Rotation = 0   })
    local arrowClose = tweenSvc:Create(arrow, TweenInfo.new(0.2), { Rotation = 180 })

    if not noCallbackOnStart then
        callback(config[title] or list[1])
        if config[title] then popup:new("Set " .. title .. " to " .. config[title]) end
    end

    self:initBtnEffect(btn)

    local function refresh(lst)
        for _, v in next, panel:GetChildren() do
            if not v:IsA("UIListLayout") then v:Destroy() end
        end
        for _, v in next, lst do
            local opt                          = Instance.new("TextButton")
            opt.BackgroundColor3               = C.dropOpt
            opt.BackgroundTransparency         = 1
            opt.BorderSizePixel                = 0
            opt.Size                           = ud2(1, 0, 0, 27)
            opt.Font                           = Enum.Font.Gotham
            opt.TextSize                       = 12
            opt.TextColor3                     = C.textMain
            opt.Text                           = v
            opt.ZIndex                         = 6
            opt.Parent                         = panel

            local hIn  = tweenSvc:Create(opt, TweenInfo.new(0.15), { BackgroundTransparency = 0.5 })
            local hOut = tweenSvc:Create(opt, TweenInfo.new(0.15), { BackgroundTransparency = 1   })
            opt.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseMovement then hIn:Play() end
            end)
            opt.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseMovement then hOut:Play() end
            end)

            opt.MouseButton1Click:Connect(function()
                config[title] = v; saveConfig()
                callback(v)
                popup:new("Set " .. title .. " to " .. v)
                arrowClose:Play()
                panel:TweenSize(ud2(1, 0, 0, 0), "Out", "Quad", 0.2, true)
                wait(0.15)
                panel.Visible = false
                self.bodyFrame.CanvasSize = oldSize
            end)
            opt.TouchTap:Connect(function() opt.MouseButton1Click:Fire() end)
        end
    end

    refresh(list)

    btn.MouseButton1Click:Connect(function()
        if not panel.Visible then
            oldSize = self.bodyFrame.CanvasSize
            local optCount = #panel:GetChildren() - 1
            self.bodyFrame.CanvasSize = oldSize + ud2(0, 0, 0, optCount * 27 + 4)
            panel.Visible = true
            arrowOpen:Play()
            panel:TweenSize(ud2(1, 0, 0, optCount * 27), "Out", "Quad", 0.2, true)
        else
            arrowClose:Play()
            panel:TweenSize(ud2(1, 0, 0, 0), "Out", "Quad", 0.2, true)
            wait(0.15)
            panel.Visible = false
            self.bodyFrame.CanvasSize = oldSize
        end
    end)
    btn.TouchTap:Connect(function() btn.MouseButton1Click:Fire() end)

    return {
        Refresh = function(_, newList)
            list = newList
            refresh(newList)
        end
    }
end

return AxewareLib


