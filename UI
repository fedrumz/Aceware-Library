    valLbl.Size = newUDim2(0.3, 0, 1, 0);
    valLbl.Position = newUDim2(0.7, 0, 0, 0);
    valLbl.Font = Enum.Font.GothamMedium;
    valLbl.TextSize = 11;
    valLbl.TextColor3 = C.ACCENT;
    valLbl.TextXAlignment = Enum.TextXAlignment.Right;
    valLbl.Text = "0";
    valLbl.Parent = headerRow;

    -- Track
    local track = Instance.new("Frame");
    track.BackgroundColor3 = C.BORDER;
    track.BorderSizePixel = 0;
    track.Size = newUDim2(1, -14, 0, 6);
    track.Position = newUDim2(0, 7, 0, 32);
    track.Parent = container;
    do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = track; end;

    local fill = Instance.new("Frame");
    fill.BackgroundColor3 = C.ACCENT;
    fill.BorderSizePixel = 0;
    fill.Size = newUDim2(0, 0, 1, 0);
    fill.Parent = track;
    do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = fill; end;

    -- Thumb (touch-friendly)
    local thumb = Instance.new("TextButton");
    thumb.BackgroundColor3 = C.WHITE;
    thumb.BorderSizePixel = 0;
    thumb.Size = newUDim2(0, 18, 0, 18);
    thumb.AnchorPoint = Vector2.new(0.5, 0.5);
    thumb.Position = newUDim2(0, 0, 0.5, 0);
    thumb.Text = "";
    thumb.ZIndex = 2;
    thumb.Parent = track;
    do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = thumb; end;

    local sp = config[title] and tonumber(config[title]) or startPoint;
    local currentValue = sp and floor(sp) or min;
    
    local function applyValue(v)
        currentValue = clamp(v, min, max);
        local scale = (currentValue - min) / (max - min);
        fill.Size = newUDim2(scale, 0, 1, 0);
        thumb.Position = newUDim2(scale, 0, 0.5, 0);
        valLbl.Text = tostring(currentValue);
        callback(currentValue);
    end;

    applyValue(currentValue);
    if config[title] then showToast("Set " .. title .. " to " .. tostring(currentValue)); end;

    local sliding = false;

    local function onInput(input)
        local rel = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X;
        local val = floor(clamp(rel, 0, 1) * (max - min) + min);
        applyValue(val);
    end;

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true;
            onInput(input);
        end;
    end);
    track.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false;
            config[title] = tostring(currentValue);
            saveConfig();
            showToast("Set " .. title .. " to " .. tostring(currentValue));
        end;
    end);
    inputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            onInput(input);
        end;
    end);
end;

-- ─────────────────────────────────────────────
-- Content:newDropdown (kept, useful element)
-- ─────────────────────────────────────────────
function AxewareLib.Content:newDropdown(title, callback, list, noCallbackOnStart)
    local row = makeRow(self.bodyFrame, 42);

    local pad = Instance.new("UIPadding");
    pad.PaddingLeft = UDim.new(0, 10);
    pad.PaddingRight = UDim.new(0, 10);
    pad.PaddingTop = UDim.new(0, 5);
    pad.PaddingBottom = UDim.new(0, 5);
    pad.Parent = row;

    local btn = Instance.new("TextButton");
    btn.BackgroundColor3 = C.ELEVATED;
    btn.BorderSizePixel = 0;
    btn.Size = newUDim2(1, 0, 1, 0);
    btn.Text = "";
    btn.Parent = row;
    do
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 7); c.Parent = btn;
        local s = Instance.new("UIStroke"); s.Color = C.BORDER; s.Thickness = 1; s.Parent = btn;
    end;

    local titleLbl = Instance.new("TextLabel");
    titleLbl.BackgroundTransparency = 1;
    titleLbl.Size = newUDim2(0.55, 0, 1, 0);
    titleLbl.Position = newUDim2(0, 10, 0, 0);
    titleLbl.Font = Enum.Font.GothamMedium;
    titleLbl.TextSize = 12;
    titleLbl.TextColor3 = C.TEXT;
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left;
    titleLbl.Text = title;
    titleLbl.Parent = btn;

    local selectedLbl = Instance.new("TextLabel");
    selectedLbl.BackgroundTransparency = 1;
    selectedLbl.AnchorPoint = Vector2.new(1, 0.5);
    selectedLbl.Position = newUDim2(1, -26, 0.5, 0);
    selectedLbl.Size = newUDim2(0.4, 0, 1, 0);
    selectedLbl.Font = Enum.Font.Gotham;
    selectedLbl.TextSize = 12;
    selectedLbl.TextColor3 = C.ACCENT;
    selectedLbl.TextXAlignment = Enum.TextXAlignment.Right;
    selectedLbl.Text = config[title] or list[1] or "";
    selectedLbl.Parent = btn;

    local arrowLbl = Instance.new("TextLabel");
    arrowLbl.BackgroundTransparency = 1;
    arrowLbl.AnchorPoint = Vector2.new(1, 0.5);
    arrowLbl.Position = newUDim2(1, -4, 0.5, 0);
    arrowLbl.Size = newUDim2(0, 18, 1, 0);
    arrowLbl.Font = Enum.Font.GothamBold;
    arrowLbl.TextSize = 11;
    arrowLbl.TextColor3 = C.SUBTEXT;
    arrowLbl.Text = "▼";
    arrowLbl.Parent = btn;

    -- Dropdown panel (sits in body's parent so it overlays)
    local panel = Instance.new("Frame");
    panel.BackgroundColor3 = C.ELEVATED;
    panel.BorderSizePixel = 0;
    panel.Size = newUDim2(1, -20, 0, 0);
    panel.Position = newUDim2(0, 10, 0, 0); -- repositioned below
    panel.ClipsDescendants = true;
    panel.ZIndex = 10;
    panel.Visible = false;
    panel.Parent = self.bodyFrame;
    do
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 7); c.Parent = panel;
        local s = Instance.new("UIStroke"); s.Color = C.ACCENT; s.Thickness = 1; s.Parent = panel;
        local l = Instance.new("UIListLayout"); l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = panel;
    end;

    local opened = false;

    local function buildItems()
        for _, v in next, panel:GetChildren() do
            if v:IsA("TextButton") then v:Destroy(); end;
        end;
        for _, item in next, list do
            local opt = Instance.new("TextButton");
            opt.BackgroundTransparency = 1;
            opt.Size = newUDim2(1, 0, 0, 30);
            opt.Font = Enum.Font.Gotham;
            opt.TextSize = 12;
            opt.TextColor3 = C.TEXT;
            opt.Text = item;
            opt.ZIndex = 11;
            opt.Parent = panel;

            opt.MouseEnter:Connect(function()
                tweenService:Create(opt, TweenInfo.new(0.1), {BackgroundTransparency = 0.85}):Play();
                opt.BackgroundColor3 = C.ACCENT;
            end);
            opt.MouseLeave:Connect(function()
                tweenService:Create(opt, TweenInfo.new(0.1), {BackgroundTransparency = 1}):Play();
            end);

            opt.MouseButton1Click:Connect(function()
                selectedLbl.Text = item;
                config[title] = item;
                saveConfig();
                callback(item);
                showToast("Set " .. title .. " to " .. item);
                -- Close
                tweenService:Create(panel, TweenInfo.new(0.15), {Size = newUDim2(1, -20, 0, 0)}):Play();
                wait(0.15);
                panel.Visible = false;
                opened = false;
                tweenService:Create(arrowLbl, TweenInfo.new(0.15), {Rotation = 0}):Play();
            end);
        end;
    end;

    buildItems();

    if not noCallbackOnStart then
        callback(config[title] or list[1] or "");
    end;

    btn.MouseButton1Click:Connect(function()
        if not opened then
            panel.Visible = true;
            opened = true;
            local targetH = #list * 30;
            tweenService:Create(panel, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Size = newUDim2(1, -20, 0, targetH)}):Play();
            tweenService:Create(arrowLbl, TweenInfo.new(0.15), {Rotation = 180}):Play();
        else
            tweenService:Create(panel, TweenInfo.new(0.15), {Size = newUDim2(1, -20, 0, 0)}):Play();
            wait(0.15);
            panel.Visible = false;
            opened = false;
            tweenService:Create(arrowLbl, TweenInfo.new(0.15), {Rotation = 0}):Play();
        end;
    end);

    return {
        Refresh = function(_, newList)
            list = newList;
            buildItems();
        end;
    };
end;

return AxewareLib;


