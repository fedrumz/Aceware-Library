function AxewareLib.Content:newColorPicker(title, callback, presetColor)
    self:Resize(self.bodyFrame);

    local oldSize;
    local rainbow        = false;
    local hueSatDragging = false;
    local valueDragging  = false;
    local h              = 0;

    -- Main row button
