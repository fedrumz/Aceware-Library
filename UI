-- AxewareLib.lua
-- Pixel-accurate rebuild of OwlLib source — zero asset dependencies
-- Matches original sizes, positions, colors, and logic exactly
-- Name: Axeware | Mobile touch support added alongside all existing mouse logic

local AxewareLib = {Content = {}};
local config = {};

local placeID    = tostring(game.PlaceId);
local httpService = game:GetService("HttpService");

pcall(function()
    config = httpService:JSONDecode(readfile(placeID .. ".txt"));
end);

local function saveConfig()
    writefile(placeID .. ".txt", httpService:JSONEncode(config));
end;

local tweenService = game:GetService("TweenService");
local inputService = game:GetService("UserInputService");
local coreGui      = game:GetService("CoreGui");

local firstBodyFrame;
local startPos;
local dragging     = false;
local draggableStart;

local mouse    = game:GetService("Players").LocalPlayer:GetMouse();
local clamp    = math.clamp;
local floor    = math.floor;
local fromHSV  = Color3.fromHSV;
local fromRGB  = Color3.fromRGB;
local newUDim2 = UDim2.new;

-- ── Popup  (replaces rbxassetid://4743303040) ─────────────────────────────────
-- Original popup:new(msg) call is preserved exactly — same API
local popupGui = Instance.new("ScreenGui");
popupGui.Name           = httpService:GenerateGUID(false);
popupGui.ResetOnSpawn   = false;
popupGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling;
popupGui.Parent         = coreGui;

local popup = {};
function popup:new(msg)
    local f = Instance.new("Frame");
    f.BackgroundColor3    = fromRGB(35, 35, 35);
    f.BorderSizePixel     = 0;
    f.Size                = newUDim2(0, 180, 0, 22);
    f.Position            = newUDim2(1, -190, 1, -32);
    f.BackgroundTransparency = 0;
    f.Parent              = popupGui;

    local lbl = Instance.new("TextLabel");
    lbl.BackgroundTransparency = 1;
    lbl.Size               = newUDim2(1, -8, 1, 0);
    lbl.Position           = newUDim2(0, 6, 0, 0);
    lbl.Font               = Enum.Font.GothamMedium;
    lbl.TextSize           = 11;
    lbl.TextColor3         = fromRGB(255, 255, 255);
    lbl.TextXAlignment     = Enum.TextXAlignment.Left;
    lbl.TextTruncate       = Enum.TextTruncate.AtEnd;
    lbl.Text               = msg;
    lbl.Parent             = f;

    delay(1.5, function()
        tweenService:Create(f,   TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play();
        tweenService:Create(lbl, TweenInfo.new(0.3), {TextTransparency = 1}):Play();
        wait(0.31);
        f:Destroy();
    end);
end;

