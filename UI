function AxewareLib:SetCategory() end

function AxewareLib.Content:Resize(sf)
    local count = 0
    for _, v in next, sf:GetChildren() do
        if not v:IsA("UIListLayout") then count += 1 end
    end
    sf.CanvasSize = ud2(0, 0, 0, count * 36)  -- FIX: match new row height (36)
end

function AxewareLib.Content:initBtnEffect(btn)
    local tIn  = tweenSvc:Create(btn, TweenInfo.new(0.15), { BackgroundTransparency = 0.88 })
    local tOut = tweenSvc:Create(btn, TweenInfo.new(0.15), { BackgroundTransparency = 1    })
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement then tIn:Play() end
    end)
    btn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement then tOut:Play() end
    end)
end

