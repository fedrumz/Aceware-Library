end);

miniBtn.MouseButton1Click:Connect(function()
    if mainFrame.Size ~= newUDim2(0, 387, 0, 27) then
        mainFrame:TweenSize(newUDim2(0, 387, 0, 27), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.25, true);
    else
        mainFrame:TweenSize(newUDim2(0, 387, 0, 225), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.25, true);
    end;
end);

inputService.InputBegan:Connect(function(input, onGui)
    if not onGui and (input.KeyCode == Enum.KeyCode.P or input.KeyCode == Enum.KeyCode.RightShift) then
        owlLibGui.Enabled = not owlLibGui.Enabled;
    end;
end);

-- ── Shared helpers ─────────────────────────────────────────────────────────────
function AxewareLib:SetCategory() end;

function AxewareLib.Content:Resize(scrollingFrame)
    local children = scrollingFrame:GetChildren();
    local count = 0;
    for _, v in next, children do
        if not v:IsA("UIListLayout") and not v:IsA("UIPadding") then
            count = count + 1;
        end;
    end;
    scrollingFrame.CanvasSize = newUDim2(0, 0, 0, count * 36);
end;

function AxewareLib.Content:initBtnEffect(btn)
    local btnHover  = tweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.85});
    local btnHover1 = tweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1});
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            btnHover:Play();
        end;
    end);
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            btnHover1:Play();
        end;
    end);
end;

-- ── AxewareLib:new(title)  →  creates a tab ───────────────────────────────────
function AxewareLib:new(title)
    local self = setmetatable({}, {__index = AxewareLib.Content});

    -- Body (ScrollingFrame, same position as original bodyFrame)
    local bodyFrame = Instance.new("ScrollingFrame");
    bodyFrame.Name = title .. "BodyFrame";
    bodyFrame.BackgroundColor3 = BG_MID;
    bodyFrame.BorderSizePixel = 0;
    bodyFrame.Position = newUDim2(0, 0, 0, 54);   -- below topBar + tabsFrame
    bodyFrame.Size = newUDim2(1, 0, 1, -54);
    bodyFrame.CanvasSize = newUDim2(0, 0, 0, 0);
    bodyFrame.ScrollBarThickness = 4;
    bodyFrame.ScrollBarImageColor3 = fromRGB(80, 80, 80);
    bodyFrame.Visible = false;
    bodyFrame.Parent = mainFrame;

    local listLayout = Instance.new("UIListLayout");
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder;
    listLayout.Parent = bodyFrame;

    self.bodyFrame = bodyFrame;

    -- Tab button (matches original: ImageButton-style, text label, sized to text)
    local tabBtn = Instance.new("TextButton");
    tabBtn.Name = title .. "TabBtn";
    tabBtn.BackgroundColor3 = BG_MID;
    tabBtn.BackgroundTransparency = 0;
    tabBtn.BorderSizePixel = 0;
    tabBtn.Size = newUDim2(0, 60, 1, 0);   -- will be resized after text set
    tabBtn.Font = Enum.Font.GothamBold;
    tabBtn.TextSize = 11;
    tabBtn.TextColor3 = TEXT_GREY;
    tabBtn.Text = string.upper(title);
    tabBtn.AutomaticSize = Enum.AutomaticSize.X;
    tabBtn.Parent = tabsFrame;

    local tabPad = Instance.new("UIPadding");
    tabPad.PaddingLeft = UDim.new(0, 10);
    tabPad.PaddingRight = UDim.new(0, 10);
    tabPad.Parent = tabBtn;

    if not firstBodyFrame then
        firstBodyFrame = bodyFrame;
        bodyFrame.Visible = true;
        tabBtn.BackgroundColor3 = BG_DARK;
        tabBtn.TextColor3 = TEXT_WHITE;
    end;

    tabBtn.MouseButton1Click:Connect(function()
        -- hide all bodies, reset all tabs
        for _, v in next, mainFrame:GetChildren() do
            if v.Name:find("BodyFrame") and v ~= bodyFrame then
                v.Visible = false;
            end;
        end;
        for _, v in next, tabsFrame:GetChildren() do
            if v:IsA("TextButton") then
                v.BackgroundColor3 = BG_MID;
                v.TextColor3 = TEXT_GREY;
            end;
        end;
        tabBtn.BackgroundColor3 = BG_DARK;
        tabBtn.TextColor3 = TEXT_WHITE;
        bodyFrame.Visible = true;
    end);

    -- Touch support for tabs
    tabBtn.TouchTap:Connect(function()
        tabBtn.MouseButton1Click:Fire();
    end);

    return self;
end;

-- ── newBtn ─────────────────────────────────────────────────────────────────────
-- Exact visual: full-width row, small statusFrame square on left, title text, transparent bg with hover
function AxewareLib.Content:newBtn(title, callback, noToggle)
    self:Resize(self.bodyFrame);

    if not noToggle then
        local enabled = config[title] and true or false;
        if enabled then
            callback(enabled);
            popup:new("Enabled " .. title);
        end;

        -- Row frame (matches original btn asset: 30px tall, full width)
        local btn = Instance.new("TextButton");
        btn.Name = title .. "Btn";
        btn.BackgroundColor3 = BG_MID;
        btn.BackgroundTransparency = 1;
        btn.BorderSizePixel = 0;
        btn.Size = newUDim2(1, 0, 0, 36);
        btn.Font = Enum.Font.Gotham;
        btn.TextSize = 1;
        btn.Text = "";
        btn.Parent = self.bodyFrame;

        -- Status square (left side, 12×12, matches original statusFrame)
        local statusFrame = Instance.new("Frame");
        statusFrame.Name = "statusFrame";
        statusFrame.BackgroundColor3 = enabled and STATUS_ON or STATUS_OFF;
        statusFrame.BorderSizePixel = 0;
        statusFrame.Size = newUDim2(0, 12, 0, 12);
        statusFrame.Position = newUDim2(0, 10, 0.5, -6);
        statusFrame.Parent = btn;

        -- Title label (matches original titleLabel, left of status)
        local titleLbl = Instance.new("TextLabel");
        titleLbl.Name = "titleLabel";
        titleLbl.BackgroundTransparency = 1;
        titleLbl.Position = newUDim2(0, 28, 0, 0);
        titleLbl.Size = newUDim2(1, -28, 1, 0);
        titleLbl.Font = Enum.Font.Gotham;
        titleLbl.TextSize = 13;
        titleLbl.TextColor3 = TEXT_WHITE;
        titleLbl.TextXAlignment = Enum.TextXAlignment.Left;
        titleLbl.Text = title;
        titleLbl.Parent = btn;

        local toggle = {[true] = STATUS_ON, [false] = STATUS_OFF};
        self:initBtnEffect(btn);

        btn.MouseButton1Click:Connect(function()
            enabled = not enabled;
            config[title] = enabled;
            saveConfig();
            tweenService:Create(statusFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = toggle[enabled]}):Play();
            callback(enabled);
            popup:new((enabled and "Enabled " or "Disabled ") .. title);
        end);

        -- Touch support
        btn.TouchTap:Connect(function()
            btn.MouseButton1Click:Fire();
        end);

        return {
            Set = function(_, bool)
                enabled = bool;
                config[title] = enabled;
                saveConfig();
                tweenService:Create(statusFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = toggle[enabled]}):Play();
                callback(enabled);
                popup:new((enabled and "Enabled " or "Disabled ") .. title);
            end;
        };

    else
        -- Action button (noToggle): no status square, just clickable row
        local btn = Instance.new("TextButton");
        btn.Name = title .. "Btn";
        btn.BackgroundColor3 = BG_MID;
        btn.BackgroundTransparency = 1;
        btn.BorderSizePixel = 0;
        btn.Size = newUDim2(1, 0, 0, 36);
        btn.Font = Enum.Font.Gotham;
        btn.TextSize = 1;
        btn.Text = "";
        btn.Parent = self.bodyFrame;

        local titleLbl = Instance.new("TextLabel");
        titleLbl.Name = "titleLabel";
        titleLbl.BackgroundTransparency = 1;
        titleLbl.Position = newUDim2(0, 10, 0, 0);
        titleLbl.Size = newUDim2(1, -10, 1, 0);
        titleLbl.Font = Enum.Font.Gotham;
        titleLbl.TextSize = 13;
        titleLbl.TextColor3 = TEXT_WHITE;
        titleLbl.TextXAlignment = Enum.TextXAlignment.Left;
        titleLbl.Text = title;
        titleLbl.Parent = btn;

        self:initBtnEffect(btn);

        btn.MouseButton1Click:Connect(function()
            callback();
            popup:new("Fired " .. title);
        end);

        btn.TouchTap:Connect(function()
            btn.MouseButton1Click:Fire();
        end);

        return {
            Fire = function(_)
                callback();
                popup:new("Fired " .. title);
            end;
        };
    end;
end;

-- ── newSlider ──────────────────────────────────────────────────────────────────
-- Exact visual: title on left, dark track bar, lighter fill, value label on right (italic grey)
function AxewareLib.Content:newSlider(title, callback, min, max, startPoint)
    self:Resize(self.bodyFrame);

    local dragging = false;

    local sliderRow = Instance.new("Frame");
    sliderRow.Name = title .. "Slider";
    sliderRow.BackgroundTransparency = 1;
    sliderRow.Size = newUDim2(1, 0, 0, 36);
    sliderRow.BorderSizePixel = 0;
    sliderRow.Parent = self.bodyFrame;

    local titleLbl = Instance.new("TextLabel");
    titleLbl.Name = "titleLabel";
    titleLbl.BackgroundTransparency = 1;
    titleLbl.Position = newUDim2(0, 10, 0, 0);
    titleLbl.Size = newUDim2(0, 100, 1, 0);
    titleLbl.Font = Enum.Font.Gotham;
    titleLbl.TextSize = 13;
    titleLbl.TextColor3 = TEXT_WHITE;
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left;
    titleLbl.Text = title;
    titleLbl.Parent = sliderRow;

    -- Slider track container (right side, matches sliderIndicatorFrame)
    local sliderIndicatorFrame = Instance.new("Frame");
    sliderIndicatorFrame.Name = "sliderIndicatorFrame";
    sliderIndicatorFrame.BackgroundColor3 = BG_LIGHT;
    sliderIndicatorFrame.BorderSizePixel = 0;
    sliderIndicatorFrame.Position = newUDim2(0, 120, 0.5, -6);
    sliderIndicatorFrame.Size = newUDim2(1, -170, 0, 12);
    sliderIndicatorFrame.Parent = sliderRow;

    -- Fill (slidingFrame)
    local slidingFrame = Instance.new("Frame");
    slidingFrame.Name = "slidingFrame";
    slidingFrame.BackgroundColor3 = fromRGB(100, 100, 100);
    slidingFrame.BorderSizePixel = 0;
    slidingFrame.Size = newUDim2(0, 0, 1, 0);
    slidingFrame.Parent = sliderIndicatorFrame;

    -- Value label (right of track, italic grey)
    local valueLabel = Instance.new("TextLabel");
    valueLabel.Name = "valueLabel";
    valueLabel.BackgroundTransparency = 1;
    valueLabel.Position = newUDim2(1, 6, 0, 0);
    valueLabel.Size = newUDim2(0, 40, 1, 0);
    valueLabel.Font = Enum.Font.GothamItalic;
    valueLabel.TextSize = 12;
    valueLabel.TextColor3 = TEXT_ITALIC_GREY;
    valueLabel.TextXAlignment = Enum.TextXAlignment.Left;
    valueLabel.Text = "0";
    valueLabel.Parent = sliderRow;

    local sp = config[title] and tonumber(config[title]) or startPoint;
    local function computeValue(scale)
        return floor(scale * (max - min) + min);
    end;

    if sp then
        local initScale = clamp((sp - min) / (max - min), 0, 1);
        local initVal = computeValue(initScale);
        slidingFrame.Size = newUDim2(initScale, 0, 1, 0);
        valueLabel.Text = tostring(initVal);
        callback(initVal);
        if config[title] then
            popup:new("Set " .. title .. " to " .. tostring(initVal));
        end;
    end;

    local function slide(input)
        local scale = clamp((input.Position.X - sliderIndicatorFrame.AbsolutePosition.X) / sliderIndicatorFrame.AbsoluteSize.X, 0, 1);
        slidingFrame:TweenSize(newUDim2(scale, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.1, true);
        local value = computeValue(scale);
        valueLabel.Text = tostring(value);
        callback(value);
    end;

    sliderIndicatorFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            slide(input);
            dragging = true;
        end;
    end);
    sliderIndicatorFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false;
            config[title] = valueLabel.Text;
            saveConfig();
            popup:new("Set " .. title .. " to " .. valueLabel.Text);
        end;
    end);
    inputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            slide(input);
        end;
    end);
end;

