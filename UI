    inputBox.Name = "inputBox";
    inputBox.BackgroundTransparency = 1;
    inputBox.Position = newUDim2(0, 135, 0, 0);
    inputBox.Size = newUDim2(1, -145, 1, 0);
    inputBox.Font = Enum.Font.GothamItalic;
    inputBox.TextSize = 12;
    inputBox.TextColor3 = TEXT_ITALIC_GREY;
    inputBox.PlaceholderColor3 = fromRGB(100, 100, 100);
    inputBox.PlaceholderText = "Enter value...";
    inputBox.TextXAlignment = Enum.TextXAlignment.Left;
    inputBox.ClearTextOnFocus = false;
    inputBox.Parent = row;

    local preset = (config[title] and config[title]) or (presetText or "");
