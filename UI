        mainFrame:TweenSize(ud2(0, 387, 0, 27), "Out", "Quad", 0.25, true)
    else
        mainFrame:TweenSize(ud2(0, 387, 0, 225), "Out", "Quad", 0.25, true)
    end
end)

inputSvc.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.P
    or input.KeyCode == Enum.KeyCode.RightShift then
        rootGui.Enabled = not rootGui.Enabled
    end
end)

