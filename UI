    titleLabel.Size               = newUDim2(1, -80, 1, 0);
    titleLabel.Font               = Enum.Font.Gotham;
    titleLabel.TextSize           = 13;
    titleLabel.TextColor3         = fromRGB(255, 255, 255);
    titleLabel.TextXAlignment     = Enum.TextXAlignment.Left;
    titleLabel.Text               = title;
    titleLabel.Parent             = row;

    local bindBtn = Instance.new("TextButton");
    bindBtn.Name             = "bindBtn";
    bindBtn.BackgroundColor3 = fromRGB(30, 30, 30);
    bindBtn.BorderSizePixel  = 0;
    bindBtn.Size             = newUDim2(0, 55, 0, 18);
    bindBtn.Position         = newUDim2(1, -62, 0.5, -9);
    bindBtn.Font             = Enum.Font.GothamBold;
    bindBtn.TextSize         = 10;
    bindBtn.TextColor3       = fromRGB(200, 200, 200);
    bindBtn.Text             = presetKeyCode and string.upper(tostring(string.char(presetKeyCode.Value))) or "KEY";
    bindBtn.Parent           = row;

    if config[title] then
        popup:new("Set " .. title .. " to " .. bindBtn.Text);
    end;

    inputService.InputBegan:Connect(function(input, onGui)
        if onGui then return; end;
        if listening and not activated then
            pcall(function()
                bindBtn.Text = string.upper(tostring(string.char(input.KeyCode.Value)));
                listening    = false;
                config[title] = input.KeyCode.Name;
                saveConfig();
                keyCode   = input.KeyCode;
                activated = true;
                popup:new("Set " .. title .. " to " .. bindBtn.Text);
            end);
        elseif activated and not listening and input.KeyCode == keyCode then
            enabled = not enabled;
            callback(enabled);
        end;
    end);

    bindBtn.MouseButton1Click:Connect(function()
        bindBtn.Text = "...";
        activated    = false;
        listening    = true;
    end);
end;

-- ── newCBind ──────────────────────────────────────────────────────────────────
-- Exact copy of original newCBind — same asset visual as newBind
function AxewareLib.Content:newCBind(title, callback, presetKeyCode)
    self:Resize(self.bodyFrame);

    local shortNames = {
        RightControl = 'RightCtrl'; LeftControl = 'LeftCtrl';
        LeftShift = 'LShift';       RightShift = 'RShift';
        MouseButton1 = "Mouse1";    MouseButton2 = "Mouse2";
    };

    presetKeyCode = presetKeyCode and presetKeyCode;
    if config[title] then
        local keyboard = config[title]:find("Keyboard");
        if keyboard then
            presetKeyCode = Enum.KeyCode[config[title]:gsub("Keyboard", "")];
        else
            presetKeyCode = Enum.UserInputType[config[title]];
        end;
        popup:new("Set " .. title .. " to " .. (shortNames[presetKeyCode.Name] or presetKeyCode.Name));
    end;

    local activated = presetKeyCode and true or false;
    local keyCode   = presetKeyCode;
    local nm        = presetKeyCode and (shortNames[presetKeyCode.Name] or presetKeyCode.Name) or "None";

    local row = Instance.new("Frame");
    row.Name                  = title .. "CBind";
    row.BackgroundTransparency = 1;
    row.BorderSizePixel       = 0;
    row.Size                  = newUDim2(1, 0, 0, 30);
    row.Parent                = self.bodyFrame;

    local titleLabel = Instance.new("TextLabel");
    titleLabel.BackgroundTransparency = 1;
    titleLabel.Position           = newUDim2(0, 8, 0, 0);
    titleLabel.Size               = newUDim2(1, -80, 1, 0);
    titleLabel.Font               = Enum.Font.Gotham;
    titleLabel.TextSize           = 13;
    titleLabel.TextColor3         = fromRGB(255, 255, 255);
    titleLabel.TextXAlignment     = Enum.TextXAlignment.Left;
    titleLabel.Text               = title;
    titleLabel.Parent             = row;

    local bindBtn = Instance.new("TextButton");
    bindBtn.Name             = "bindBtn";
    bindBtn.BackgroundColor3 = fromRGB(30, 30, 30);
    bindBtn.BorderSizePixel  = 0;
    bindBtn.Size             = newUDim2(0, 55, 0, 18);
    bindBtn.Position         = newUDim2(1, -62, 0.5, -9);
    bindBtn.Font             = Enum.Font.GothamBold;
    bindBtn.TextSize         = 10;
    bindBtn.TextColor3       = fromRGB(200, 200, 200);
    bindBtn.Text             = nm;
    bindBtn.Parent           = row;

    local function isreallypressed(bind, inp)
        local key = bind;
        if typeof(key) == "Instance" then
            if key.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode == key.KeyCode then return true; end;
            if tostring(key.UserInputType):find("MouseButton") and inp.UserInputType == key.UserInputType then return true; end;
        end;
        if tostring(key):find("MouseButton") then return key == inp.UserInputType; end;
        return key == inp.KeyCode;
    end;

    inputService.InputBegan:Connect(function(input, onGui)
        if onGui then return; end;
        if activated and isreallypressed(keyCode, input) then callback(true); end;
    end);
    inputService.InputEnded:Connect(function(input, onGui)
        if onGui then return; end;
        if activated and isreallypressed(keyCode, input) then callback(false); end;
    end);

    bindBtn.MouseButton1Click:Connect(function()
        bindBtn.Text = "...";
        activated    = false;
        local input  = inputService.InputBegan:Wait();
        config[title] = (input.UserInputType ~= Enum.UserInputType.Keyboard
            and input.UserInputType.Name or input.KeyCode.Name .. "Keyboard");
        saveConfig();
        keyCode = input;
        local name = (input.UserInputType ~= Enum.UserInputType.Keyboard
            and (shortNames[input.UserInputType.Name] or input.UserInputType.Name)
            or  input.KeyCode.Name);
        bindBtn.Text = name;
        activated    = true;
        popup:new("Set " .. title .. " to " .. name);
    end);
end;

