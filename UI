-- AxewareLib.lua
-- Exact visual rebuild of OwlLib — no asset dependencies, mobile touch support added
-- Name changed to Axeware. Elements: Tabs, Toggle Buttons, Action Buttons, Textbox, Sliders, Binds, Dropdowns, Color Picker

local AxewareLib = {Content = {}};
local config = {};

local placeID = tostring(game.PlaceId);
local httpService = game:GetService("HttpService");

pcall(function()
    config = httpService:JSONDecode(readfile(placeID .. ".txt"));
end);

local function saveConfig()
    writefile(placeID .. ".txt", httpService:JSONEncode(config));
end;

local tweenService = game:GetService("TweenService");
local inputService = game:GetService("UserInputService");
local coreGui      = game:GetService("CoreGui");

local firstBodyFrame;
local startPos;
local dragging = false;
local draggableStart;

local mouse  = game:GetService("Players").LocalPlayer:GetMouse();
local clamp  = math.clamp;
local floor  = math.floor;
local fromHSV = Color3.fromHSV;
local fromRGB = Color3.fromRGB;
local newUDim2 = UDim2.new;

-- ── Colors (matched from screenshot) ──────────────────────────────────────────
local BG_DARK    = fromRGB(30, 30, 30);   -- mainFrame / topbar active tab
local BG_MID     = fromRGB(45, 45, 45);   -- body background, inactive tab
local BG_LIGHT   = fromRGB(55, 55, 55);   -- slider track, hover
local TEXT_WHITE = fromRGB(255, 255, 255);
local TEXT_GREY  = fromRGB(170, 170, 170);
local TEXT_ITALIC_GREY = fromRGB(150, 150, 150);
local STATUS_ON  = fromRGB(0, 194, 94);
local STATUS_OFF = fromRGB(180, 0, 0);

-- ── Popup (toast) — replaces the asset-based popup ────────────────────────────
local popupScreenGui = Instance.new("ScreenGui");
popupScreenGui.Name = httpService:GenerateGUID(false);
popupScreenGui.ResetOnSpawn = false;
popupScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling;
popupScreenGui.Parent = coreGui;

local popup = {};
function popup:new(msg)
    local f = Instance.new("Frame");
    f.BackgroundColor3 = fromRGB(40, 40, 40);
    f.BorderSizePixel = 0;
    f.Size = newUDim2(0, 200, 0, 24);
    f.Position = newUDim2(1, -210, 1, -34);
    f.BackgroundTransparency = 0.1;
    f.Parent = popupScreenGui;
    local lbl = Instance.new("TextLabel");
    lbl.BackgroundTransparency = 1;
    lbl.Size = newUDim2(1, -8, 1, 0);
    lbl.Position = newUDim2(0, 6, 0, 0);
    lbl.Font = Enum.Font.GothamMedium;
    lbl.TextSize = 11;
    lbl.TextColor3 = TEXT_WHITE;
    lbl.TextXAlignment = Enum.TextXAlignment.Left;
    lbl.TextTruncate = Enum.TextTruncate.AtEnd;
    lbl.Text = msg;
    lbl.Parent = f;
    delay(1.5, function()
        tweenService:Create(f, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play();
        tweenService:Create(lbl, TweenInfo.new(0.3), {TextTransparency = 1}):Play();
        wait(0.31); f:Destroy();
    end);
end;

