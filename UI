local function makeTopBtn(symbol, xOffset)
    local b                      = Instance.new("TextButton")
    b.BackgroundTransparency     = 1
    b.BorderSizePixel            = 0
    b.Size                       = ud2off(20, 20)
    b.Position                   = ud2(1, xOffset, 0.5, -10)
    b.Font                       = Enum.Font.GothamBold
    b.TextSize                   = 15
    b.TextColor3                 = C.textGrey
