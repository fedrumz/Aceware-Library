    hueSatIndicatorFrame.Parent = hueSatFrame;

    local valueFrame = Instance.new("ImageLabel");
    valueFrame.Name = "valueFrame";
    valueFrame.BackgroundColor3 = fromRGB(255, 0, 0);
    valueFrame.BorderSizePixel = 0;
    valueFrame.Position = newUDim2(0, 138, 0, 4);
    valueFrame.Size = newUDim2(0, 16, 0, 90);
    valueFrame.Image = "rbxassetid://4155801252";
    valueFrame.ImageColor3 = fromRGB(255, 255, 255);
