function AxewareLib.Content:newColorPicker(title, callback, presetColor)
    local oldSize
    local rainbow        = false
    local hueSatDrag     = false
    local valDrag        = false
    local h              = 0

    local btn                          = Instance.new("TextButton")
    btn.BackgroundColor3               = C.white
    btn.BackgroundTransparency         = 1
    btn.BorderSizePixel                = 0
    btn.Size                           = ud2(1, 0, 0, 36)    -- FIX: 30 → 36
    btn.Text                           = ""
    btn.Parent                         = self.bodyFrame
    

    local colorDot                     = Instance.new("Frame")
    colorDot.BorderSizePixel           = 0
    colorDot.Size                      = ud2off(14, 14)
    colorDot.Position                  = ud2(0, 10, 0.5, -7)
    colorDot.Parent                    = btn

    local titleLbl                     = Instance.new("TextLabel")
    titleLbl.BackgroundTransparency    = 1
    titleLbl.Position                  = ud2(0, 30, 0, 0)
    titleLbl.Size                      = ud2(1, -40, 1, 0)
    titleLbl.Font                      = Enum.Font.Gotham
    titleLbl.TextSize                  = 14    -- FIX: 13 → 14
    titleLbl.TextColor3                = C.textMain
    titleLbl.TextXAlignment            = Enum.TextXAlignment.Left
    titleLbl.Text                      = title
    titleLbl.Parent                    = btn

    local panel                        = Instance.new("Frame")
    panel.BackgroundColor3             = fromRGB(28, 28, 28)
    panel.BorderSizePixel              = 0
    panel.Position                     = ud2(0, 8, 1, 0)
    panel.Size                         = ud2(0, 170, 0, 0)
    panel.ClipsDescendants             = true
    panel.Visible                      = false
    panel.ZIndex                       = 5
    panel.Parent                       = btn

    local hueSat                       = Instance.new("ImageLabel")
    hueSat.BackgroundColor3            = fromRGB(255, 0, 0)
    hueSat.BorderSizePixel             = 0
    hueSat.Position                    = ud2(0, 4, 0, 4)
    hueSat.Size                        = ud2(0, 130, 0, 90)
    hueSat.Image                       = "rbxassetid://4155801252"
    hueSat.ZIndex                      = 5
    hueSat.Parent                      = panel

    local hueSatCursor                 = Instance.new("Frame")
    hueSatCursor.BackgroundColor3      = C.white
    hueSatCursor.BorderSizePixel       = 1
    hueSatCursor.Size                  = ud2off(6, 6)
    hueSatCursor.Position              = ud2(0, 0, 0, 0)
    hueSatCursor.ZIndex                = 6
    hueSatCursor.Parent                = hueSat

    local valStrip                     = Instance.new("ImageLabel")
    valStrip.BackgroundColor3          = fromRGB(255, 0, 0)
    valStrip.BorderSizePixel           = 0
    valStrip.Position                  = ud2(0, 138, 0, 4)
    valStrip.Size                      = ud2(0, 16, 0, 90)
    valStrip.Image                     = "rbxassetid://4155801252"
    valStrip.ZIndex                    = 5
    valStrip.Parent                    = panel

    local valCursor                    = Instance.new("Frame")
    valCursor.BackgroundColor3         = C.white
    valCursor.BorderSizePixel          = 1
    valCursor.Size                     = ud2(1, 0, 0, 4)
    valCursor.Position                 = ud2(0, 0, 0, 0)
    valCursor.ZIndex                   = 6
    valCursor.Parent                   = valStrip

    local rainbowBtn                   = Instance.new("TextButton")
    rainbowBtn.BackgroundColor3        = fromRGB(55, 55, 55)
    rainbowBtn.BorderSizePixel         = 0
    rainbowBtn.Position                = ud2(0, 4, 0, 98)
    rainbowBtn.Size                    = ud2(0, 150, 0, 16)
    rainbowBtn.Font                    = Enum.Font.GothamBold
    rainbowBtn.TextSize                = 10
    rainbowBtn.TextColor3              = C.white
    rainbowBtn.Text                    = "RAINBOW"
    rainbowBtn.ZIndex                  = 5
    rainbowBtn.Parent                  = panel

    presetColor = presetColor or fromRGB(255, 255, 255)
    if config[title] then
        if type(config[title]) == "table" and config[title]["R"] then
            presetColor = fromRGB(config[title]["R"], config[title]["G"], config[title]["B"])
            popup:new("Set " .. title .. " to "
                .. floor(config[title]["R"]) .. " "
                .. floor(config[title]["G"]) .. " "
                .. floor(config[title]["B"]))
        elseif config[title] == "Rainbow" then
            rainbow = true
            popup:new("Set " .. title .. " to rainbow")
        end
    end
    callback(presetColor)
    colorDot.BackgroundColor3 = presetColor

    self:initBtnEffect(btn)

    btn.MouseButton1Click:Connect(function()
        if not panel.Visible then
            oldSize = self.bodyFrame.CanvasSize
            self.bodyFrame.CanvasSize = oldSize + ud2(0, 0, 0, 130)
            panel.Visible = true
            panel:TweenSize(ud2(0, 170, 0, 120), "Out", "Quad", 0.2, true)
        else
            panel:TweenSize(ud2(0, 170, 0, 0), "Out", "Quad", 0.2, true)
            wait(0.15)
            panel.Visible = false
            self.bodyFrame.CanvasSize = oldSize
        end
    end)
    btn.TouchTap:Connect(function() btn.MouseButton1Click:Fire() end)

    rainbowBtn.MouseButton1Click:Connect(function()
        config[title] = "Rainbow"; saveConfig()
        rainbow = true
        popup:new("Set " .. title .. " to rainbow")
    end)

    local function saveColor()
        config[title] = {
            R = colorDot.BackgroundColor3.R * 255,
            G = colorDot.BackgroundColor3.G * 255,
            B = colorDot.BackgroundColor3.B * 255,
        }
        saveConfig()
        popup:new("Set " .. title .. " to "
            .. floor(colorDot.BackgroundColor3.R * 255) .. " "
            .. floor(colorDot.BackgroundColor3.G * 255) .. " "
            .. floor(colorDot.BackgroundColor3.B * 255))
    end

    hueSat.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then hueSatDrag = true end
    end)
    hueSat.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            hueSatDrag = false; saveColor()
        end
    end)
    valStrip.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then valDrag = true end
    end)
    valStrip.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            valDrag = false; saveColor()
        end
    end)

    inputSvc.InputChanged:Connect(function(input)
        local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
                     or input.UserInputType == Enum.UserInputType.Touch
        if not isMouse then return end

        if hueSatDrag then
            rainbow = false
            h = clamp((input.Position.X - hueSat.AbsolutePosition.X) / hueSat.AbsoluteSize.X, 0, 1)
            local s = clamp((input.Position.Y - hueSat.AbsolutePosition.Y) / hueSat.AbsoluteSize.Y, 0, 1)
            hueSatCursor.Position      = ud2(h, 0, s, 0)
            valCursor.BackgroundColor3 = fromHSV(h, 1 - (1 - s), 1)
            colorDot.BackgroundColor3  = fromHSV(h, 1 - s, 1 - valCursor.Position.Y.Scale)
            valStrip.ImageColor3       = fromHSV(h, 1 - s, 1)
            callback(colorDot.BackgroundColor3)

        elseif valDrag then
            rainbow = false
            local v = clamp((input.Position.Y - valStrip.AbsolutePosition.Y) / valStrip.AbsoluteSize.Y, 0, 1)
            valCursor.Position         = ud2(0, 0, v, 0)
            colorDot.BackgroundColor3  = fromHSV(
                hueSatCursor.Position.X.Scale,
                1 - hueSatCursor.Position.Y.Scale,
                1 - v)
            callback(colorDot.BackgroundColor3)
        end
    end)

    spawn(function()
        while true do
            for i = 1, 230 do
                rainbowBtn.TextColor3 = fromHSV(i / 230, 1, 1)
                if rainbow then
                    colorDot.BackgroundColor3 = fromHSV(i / 230, 1, 1)
                    callback(fromHSV(i / 230, 1, 1))
                end
                wait()
            end
            wait()
        end
    end)
end

