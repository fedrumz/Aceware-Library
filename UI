-- ─────────────────────────────────────────────
-- Content:newBtn(title, callback, noToggle)
-- ─────────────────────────────────────────────
function AxewareLib.Content:newBtn(title, callback, noToggle)
    local row = makeRow(self.bodyFrame, 42);

    local pad = Instance.new("UIPadding");
    pad.PaddingLeft = UDim.new(0, 10);
    pad.PaddingRight = UDim.new(0, 10);
    pad.PaddingTop = UDim.new(0, 5);
    pad.PaddingBottom = UDim.new(0, 5);
    pad.Parent = row;

    local btn = Instance.new("TextButton");
    btn.BackgroundColor3 = C.ELEVATED;
    btn.BorderSizePixel = 0;
    btn.Size = newUDim2(1, 0, 1, 0);
    btn.Font = Enum.Font.GothamMedium;
    btn.TextSize = 13;
    btn.TextColor3 = C.TEXT;
    btn.TextXAlignment = Enum.TextXAlignment.Left;
    btn.Text = "";
    btn.Parent = row;
    do
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 7); c.Parent = btn;
        local s = Instance.new("UIStroke"); s.Color = C.BORDER; s.Thickness = 1; s.Parent = btn;
    end;

    local innerPad = Instance.new("UIPadding");
    innerPad.PaddingLeft = UDim.new(0, 10);
    innerPad.PaddingRight = UDim.new(0, 10);
    innerPad.Parent = btn;

    local titleLbl = Instance.new("TextLabel");
    titleLbl.BackgroundTransparency = 1;
    titleLbl.Size = newUDim2(1, -50, 1, 0);
    titleLbl.Font = Enum.Font.GothamMedium;
    titleLbl.TextSize = 13;
    titleLbl.TextColor3 = C.TEXT;
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left;
    titleLbl.Text = title;
    titleLbl.Parent = btn;

    -- Hover tween
    local hoverIn  = tweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = C.BORDER});
    local hoverOut = tweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = C.ELEVATED});
    btn.MouseEnter:Connect(function() hoverIn:Play(); end);
    btn.MouseLeave:Connect(function() hoverOut:Play(); end);

    if not noToggle then
        -- Toggle button with status pill
        local enabled = config[title] and true or false;

        local pill = Instance.new("Frame");
        pill.Name = "Pill";
        pill.AnchorPoint = Vector2.new(1, 0.5);
        pill.Position = newUDim2(1, 0, 0.5, 0);
        pill.Size = newUDim2(0, 32, 0, 16);
        pill.BackgroundColor3 = enabled and C.ON_GREEN or C.ON_RED;
        pill.BorderSizePixel = 0;
        pill.Parent = btn;
        do
            local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = pill;
        end;

        local dot = Instance.new("Frame");
        dot.BackgroundColor3 = C.WHITE;
        dot.BorderSizePixel = 0;
        dot.Size = newUDim2(0, 10, 0, 10);
        dot.AnchorPoint = Vector2.new(0, 0.5);
        dot.Position = enabled and newUDim2(1, -13, 0.5, 0) or newUDim2(0, 3, 0.5, 0);
        dot.Parent = pill;
        do
            local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = dot;
        end;

        local function setToggle(val)
            enabled = val;
            tweenService:Create(pill, TweenInfo.new(0.2), {BackgroundColor3 = enabled and C.ON_GREEN or C.ON_RED}):Play();
            tweenService:Create(dot, TweenInfo.new(0.2), {Position = enabled and newUDim2(1, -13, 0.5, 0) or newUDim2(0, 3, 0.5, 0)}):Play();
        end;

        if enabled then
            callback(true);
            showToast("Enabled " .. title);
        end;

        btn.MouseButton1Click:Connect(function()
            enabled = not enabled;
            config[title] = enabled;
            saveConfig();
            setToggle(enabled);
            callback(enabled);
            showToast((enabled and "Enabled " or "Disabled ") .. title);
        end);

        return {
            Set = function(_, bool)
                setToggle(bool);
                config[title] = bool;
                saveConfig();
                callback(bool);
                showToast((bool and "Enabled " or "Disabled ") .. title);
            end;
        };

    else
        -- Action button (no toggle)
        local actLbl = Instance.new("TextLabel");
        actLbl.BackgroundTransparency = 1;
        actLbl.AnchorPoint = Vector2.new(1, 0.5);
        actLbl.Position = newUDim2(1, 0, 0.5, 0);
        actLbl.Size = newUDim2(0, 20, 1, 0);
        actLbl.Font = Enum.Font.GothamBold;
        actLbl.TextSize = 14;
        actLbl.TextColor3 = C.ACCENT;
        actLbl.Text = "▶";
        actLbl.Parent = btn;

        btn.MouseButton1Click:Connect(function()
            callback();
            showToast("Fired " .. title);
        end);

        return {
            Fire = function(_)
                callback();
                showToast("Fired " .. title);
            end;
        };
    end;
end;

-- ─────────────────────────────────────────────
-- Content:newTextbox(title, callback, presetText, noCallbackOnStart)
-- ─────────────────────────────────────────────
function AxewareLib.Content:newTextbox(title, callback, presetText, noCallbackOnStart)
    local row = makeRow(self.bodyFrame, 56);

    local pad = Instance.new("UIPadding");
    pad.PaddingLeft = UDim.new(0, 10);
    pad.PaddingRight = UDim.new(0, 10);
    pad.PaddingTop = UDim.new(0, 4);
    pad.PaddingBottom = UDim.new(0, 4);
    pad.Parent = row;

    local container = Instance.new("Frame");
    container.BackgroundColor3 = C.ELEVATED;
    container.BorderSizePixel = 0;
    container.Size = newUDim2(1, 0, 1, 0);
    container.Parent = row;
    do
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 7); c.Parent = container;
        local s = Instance.new("UIStroke"); s.Color = C.BORDER; s.Thickness = 1; s.Parent = container;
    end;

    local lbl = Instance.new("TextLabel");
    lbl.BackgroundTransparency = 1;
    lbl.Size = newUDim2(1, -14, 0, 18);
    lbl.Position = newUDim2(0, 10, 0, 5);
    lbl.Font = Enum.Font.Gotham;
    lbl.TextSize = 11;
    lbl.TextColor3 = C.SUBTEXT;
    lbl.TextXAlignment = Enum.TextXAlignment.Left;
    lbl.Text = title;
    lbl.Parent = container;

    local box = Instance.new("TextBox");
    box.BackgroundTransparency = 1;
    box.Size = newUDim2(1, -14, 0, 20);
    box.Position = newUDim2(0, 10, 0, 24);
    box.Font = Enum.Font.GothamMedium;
    box.TextSize = 13;
    box.TextColor3 = C.TEXT;
    box.PlaceholderColor3 = C.SUBTEXT;
    box.PlaceholderText = "Enter value...";
    box.TextXAlignment = Enum.TextXAlignment.Left;
    box.ClearTextOnFocus = false;
    box.Parent = container;

    local preset = (config[title] and config[title]) or (presetText or "");
    box.Text = preset;

    if not noCallbackOnStart then
        callback(preset);
    end;

    -- Focus stroke highlight
    box.Focused:Connect(function()
        tweenService:Create(container:FindFirstChildOfClass("UIStroke"), TweenInfo.new(0.15), {Color = C.ACCENT}):Play();
    end);
    box.FocusLost:Connect(function()
        tweenService:Create(container:FindFirstChildOfClass("UIStroke"), TweenInfo.new(0.15), {Color = C.BORDER}):Play();
        config[title] = box.Text;
        saveConfig();
        callback(box.Text);
        showToast("Set " .. title .. " to " .. box.Text);
    end);
end;

