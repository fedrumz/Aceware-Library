-- ── Dragging (mouse + touch) ───────────────────────────────────────────────────
topBarFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true;
        draggableStart = input.Position;
        startPos = mainFrame.AbsolutePosition;
    end;
end);
topBarFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false;
    end;
end);
inputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        mainFrame.Position = newUDim2(0,
            startPos.X + (input.Position.X - draggableStart.X), 0,
            startPos.Y + (input.Position.Y - draggableStart.Y));
    end;
end);

