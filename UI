local visuals = AxewareLib:new("Visuals")

-- Toggle (red = off, green = on, persists across sessions)
main:newBtn("Aimbot", function(on)
    print("Aimbot:", on)
end)

-- Action (fires once, no toggle state)
main:newBtn("Kill All", function()
    print("Kill All!")
end, true)

-- Textbox  (title, callback, placeholder, noCallbackOnStart)
main:newTextbox("Target Name", function(text)
    print("Target:", text)
end, "Player1", true)

-- Dropdown  (title, callback, list, noCallbackOnStart)
local dd = main:newDropdown("Aim Part", function(v)
    print("Aim part:", v)
end, {"Head", "Torso", "HumanoidRootPart"})

-- dd:Refresh({"Head", "Torso"})   -- update list any time

-- Toggle keybind (toggles enabled each press)
main:newBind("Aimbot Key", function(on)
    print("Aimbot active:", on)
end, Enum.KeyCode.E)

-- Hold keybind (true while held, false on release)
main:newCBind("Trigger Key", function(held)
    print("Trigger held:", held)
end)

-- Color picker
visuals:newColorPicker("ESP Color", function(color)
    print("Color:", color)
end, Color3.fromRGB(255, 0, 0))

visuals:newBtn("Chams", function(on)
    print("Chams:", on)
end)

