    local titleLabel = Instance.new("TextLabel");
    titleLabel.BackgroundTransparency = 1;
    titleLabel.Position           = newUDim2(0, 24, 0, 0);
    titleLabel.Size               = newUDim2(1, -34, 1, 0);
    titleLabel.Font               = Enum.Font.Gotham;
    titleLabel.TextSize           = 13;
    titleLabel.TextColor3         = fromRGB(255, 255, 255);
    titleLabel.TextXAlignment     = Enum.TextXAlignment.Left;
    titleLabel.Text               = title;
    titleLabel.Parent             = btn;

    -- colorPickingFrame: hidden until clicked, expands to 170×120
    local colorPickingFrame = Instance.new("Frame");
    colorPickingFrame.Name             = "colorPickingFrame";
    colorPickingFrame.BackgroundColor3 = fromRGB(30, 30, 30);
    colorPickingFrame.BorderSizePixel  = 0;
    colorPickingFrame.Position         = newUDim2(0, 8, 1, 0);
    colorPickingFrame.Size             = newUDim2(0, 170, 0, 0);
    colorPickingFrame.ClipsDescendants = true;
    colorPickingFrame.Visible          = false;
    colorPickingFrame.ZIndex           = 5;
    colorPickingFrame.Parent           = btn;

    -- hueSatFrame: hue/sat gradient picker
    local hueSatFrame = Instance.new("ImageLabel");
    hueSatFrame.Name             = "hueSatFrame";
    hueSatFrame.BackgroundColor3 = fromRGB(255, 0, 0);
    hueSatFrame.BorderSizePixel  = 0;
    hueSatFrame.Position         = newUDim2(0, 4, 0, 4);
    hueSatFrame.Size             = newUDim2(0, 130, 0, 90);
    hueSatFrame.Image            = "rbxassetid://4155801252";
    hueSatFrame.ZIndex           = 5;
    hueSatFrame.Parent           = colorPickingFrame;

    local hueSatIndicatorFrame = Instance.new("Frame");
    hueSatIndicatorFrame.Name             = "hueSatIndicatorFrame";
    hueSatIndicatorFrame.BackgroundColor3 = fromRGB(255, 255, 255);
    hueSatIndicatorFrame.BorderSizePixel  = 1;
    hueSatIndicatorFrame.Size             = newUDim2(0, 6, 0, 6);
    hueSatIndicatorFrame.Position         = newUDim2(0, 0, 0, 0);
    hueSatIndicatorFrame.ZIndex           = 6;
    hueSatIndicatorFrame.Parent           = hueSatFrame;

    local valueFrame = Instance.new("ImageLabel");
    valueFrame.Name             = "valueFrame";
    valueFrame.BackgroundColor3 = fromRGB(255, 0, 0);
    valueFrame.BorderSizePixel  = 0;
    valueFrame.Position         = newUDim2(0, 138, 0, 4);
    valueFrame.Size             = newUDim2(0, 16, 0, 90);
    valueFrame.Image            = "rbxassetid://4155801252";
    valueFrame.ZIndex           = 5;
    valueFrame.Parent           = colorPickingFrame;

    local valueIndicatorFrame = Instance.new("Frame");
    valueIndicatorFrame.Name             = "valueIndicatorFrame";
    valueIndicatorFrame.BackgroundColor3 = fromRGB(255, 255, 255);
    valueIndicatorFrame.BorderSizePixel  = 1;
    valueIndicatorFrame.Size             = newUDim2(1, 0, 0, 4);
    valueIndicatorFrame.Position         = newUDim2(0, 0, 0, 0);
    valueIndicatorFrame.ZIndex           = 6;
    valueIndicatorFrame.Parent           = valueFrame;

    local rainbowBtn = Instance.new("TextButton");
    rainbowBtn.Name             = "rainbowBtn";
    rainbowBtn.BackgroundColor3 = fromRGB(55, 55, 55);
    rainbowBtn.BorderSizePixel  = 0;
    rainbowBtn.Position         = newUDim2(0, 4, 0, 98);
    rainbowBtn.Size             = newUDim2(0, 150, 0, 16);
    rainbowBtn.Font             = Enum.Font.GothamBold;
    rainbowBtn.TextSize         = 10;
    rainbowBtn.TextColor3       = fromRGB(255, 255, 255);
    rainbowBtn.Text             = "RAINBOW";
    rainbowBtn.ZIndex           = 5;
    rainbowBtn.Parent           = colorPickingFrame;

    presetColor = presetColor or fromRGB(255, 255, 255);
    if config[title] then
        if type(config[title]) == "table" and config[title]["R"] then
            presetColor = fromRGB(config[title]["R"], config[title]["G"], config[title]["B"]);
            popup:new("Set " .. title .. " to " .. floor(config[title]["R"]) .. " " .. floor(config[title]["G"]) .. " " .. floor(config[title]["B"]));
        elseif config[title] == "Rainbow" then
            rainbow = true;
            popup:new("Set " .. title .. " to rainbow");
        end;
    end;

    callback(presetColor);
    colorFrame.BackgroundColor3 = presetColor;

    self:initBtnEffect(btn);

    btn.MouseButton1Click:Connect(function()
        if not colorPickingFrame.Visible then
            oldSize = self.bodyFrame.CanvasSize;
            self.bodyFrame.CanvasSize = oldSize + newUDim2(0, 0, 0, 170);
            colorPickingFrame.Visible = true;
            colorPickingFrame:TweenSize(newUDim2(0, 170, 0, 120), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true);
        elseif colorPickingFrame.Visible then
            colorPickingFrame:TweenSize(newUDim2(0, 170, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true);
            wait(0.15);
            colorPickingFrame.Visible = false;
            self.bodyFrame.CanvasSize = oldSize;
        end;
    end);

    btn.TouchTap:Connect(function() btn.MouseButton1Click:Fire(); end);

    rainbowBtn.MouseButton1Click:Connect(function()
        config[title] = "Rainbow"; saveConfig();
        rainbow = true;
        popup:new("Set " .. title .. " to rainbow");
    end);

    hueSatFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then hueSatDragging = true; end;
    end);
    hueSatFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            hueSatDragging = false;
            config[title] = {R = colorFrame.BackgroundColor3.R * 255, G = colorFrame.BackgroundColor3.G * 255, B = colorFrame.BackgroundColor3.B * 255};
            saveConfig();
            popup:new("Set " .. title .. " to " .. floor(colorFrame.BackgroundColor3.R * 255) .. " " .. floor(colorFrame.BackgroundColor3.G * 255) .. " " .. floor(colorFrame.BackgroundColor3.B * 255));
        end;
    end);
    valueFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then valueDragging = true; end;
    end);
    valueFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            valueDragging = false;
            config[title] = {R = colorFrame.BackgroundColor3.R * 255, G = colorFrame.BackgroundColor3.G * 255, B = colorFrame.BackgroundColor3.B * 255};
            saveConfig();
            popup:new("Set " .. title .. " to " .. floor(colorFrame.BackgroundColor3.R * 255) .. " " .. floor(colorFrame.BackgroundColor3.G * 255) .. " " .. floor(colorFrame.BackgroundColor3.B * 255));
        end;
    end);

    -- Exact original InputChanged logic
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if hueSatDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            rainbow = false;
            h = clamp((input.Position.X - hueSatFrame.AbsolutePosition.X) / hueSatFrame.AbsoluteSize.X, 0, 1);
            hueSatIndicatorFrame.Position  = newUDim2(h, 0, clamp((input.Position.Y - hueSatFrame.AbsolutePosition.Y) / hueSatFrame.AbsoluteSize.Y, 0, 1), 0);
            valueIndicatorFrame.BackgroundColor3 = fromHSV(h, 1 - (1 - hueSatIndicatorFrame.Position.Y.Scale), 1);
            colorFrame.BackgroundColor3    = fromHSV(hueSatIndicatorFrame.Position.X.Scale, 1 - hueSatIndicatorFrame.Position.Y.Scale, 1 - valueIndicatorFrame.Position.Y.Scale);
            valueFrame.ImageColor3         = fromHSV(hueSatIndicatorFrame.Position.X.Scale, 1 - hueSatIndicatorFrame.Position.Y.Scale, 1);
            callback(colorFrame.BackgroundColor3);
        elseif valueDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            rainbow = false;
            valueIndicatorFrame.Position   = newUDim2(0, 0, clamp((input.Position.Y - valueFrame.AbsolutePosition.Y) / valueFrame.AbsoluteSize.Y, 0, 1), 0);
            valueIndicatorFrame.BackgroundColor3 = fromHSV(h, 1 - (1 - hueSatIndicatorFrame.Position.Y.Scale), 1);
            colorFrame.BackgroundColor3    = fromHSV(hueSatIndicatorFrame.Position.X.Scale, 1 - hueSatIndicatorFrame.Position.Y.Scale, 1 - valueIndicatorFrame.Position.Y.Scale);
            valueFrame.ImageColor3         = fromHSV(hueSatIndicatorFrame.Position.X.Scale, 1 - hueSatIndicatorFrame.Position.Y.Scale, 1);
            callback(colorFrame.BackgroundColor3);
        end;
    end);

    -- Exact original rainbow loop
    spawn(function()
        while true do
            for i = 1, 230 do
                rainbowBtn.TextColor3 = fromHSV(i / 230, 1, 1);
                if rainbow then
                    colorFrame.BackgroundColor3 = fromHSV(i / 230, 1, 1);
                    callback(fromHSV(i / 230, 1, 1));
                end;
                wait();
            end;
            wait();
        end;
    end);
end;

-- ── newDropdown ───────────────────────────────────────────────────────────────
-- Original (rbxassetid://4531687341):
--   30px row, .titleLabel left, .arrowLabel right (rotates 0↔180)
--   .bodyFrame expands below: 170 wide, (#children-1)*27 tall
--   each option from rbxassetid://4531683854: 27px TextButton inside bodyFrame
function AxewareLib.Content:newDropdown(title, callback, list, noCallbackOnStart)
    self:Resize(self.bodyFrame);

    local oldSize;

    local btn = Instance.new("TextButton");
    btn.Name                  = title .. "Dropdown";
    btn.BackgroundColor3      = fromRGB(50, 50, 50);
    btn.BackgroundTransparency = 1;
    btn.BorderSizePixel       = 0;
    btn.Size                  = newUDim2(1, 0, 0, 30);
    btn.Text                  = "";
    btn.Parent                = self.bodyFrame;

    local titleLabel = Instance.new("TextLabel");
    titleLabel.Name               = "titleLabel";
    titleLabel.BackgroundTransparency = 1;
    titleLabel.Position           = newUDim2(0, 8, 0, 0);
    titleLabel.Size               = newUDim2(1, -30, 1, 0);
    titleLabel.Font               = Enum.Font.Gotham;
    titleLabel.TextSize           = 13;
    titleLabel.TextColor3         = fromRGB(255, 255, 255);
    titleLabel.TextXAlignment     = Enum.TextXAlignment.Left;
    titleLabel.Text               = title;
    titleLabel.Parent             = btn;

    -- arrowLabel: "v" rotates to 180° when open
    local arrowLabel = Instance.new("TextLabel");
    arrowLabel.Name               = "arrowLabel";
    arrowLabel.BackgroundTransparency = 1;
    arrowLabel.Position           = newUDim2(1, -18, 0, 0);
    arrowLabel.Size               = newUDim2(0, 14, 1, 0);
    arrowLabel.Font               = Enum.Font.GothamBold;
    arrowLabel.TextSize           = 10;
    arrowLabel.TextColor3         = fromRGB(180, 180, 180);
    arrowLabel.Text               = "v";
    arrowLabel.Rotation           = 180;
    arrowLabel.Parent             = btn;

    -- bodyFrame: dropdown panel, 170 wide, expands below btn
    local bodyFrame = Instance.new("Frame");
    bodyFrame.Name             = "bodyFrame";
    bodyFrame.BackgroundColor3 = fromRGB(35, 35, 35);
    bodyFrame.BorderSizePixel  = 0;
    bodyFrame.Position         = newUDim2(0, 0, 1, 0);
    bodyFrame.Size             = newUDim2(0, 170, 0, 0);
    bodyFrame.ClipsDescendants = true;
    bodyFrame.ZIndex           = 5;
    bodyFrame.Visible          = false;
    bodyFrame.Parent           = btn;

    local ddLayout = Instance.new("UIListLayout");
    ddLayout.SortOrder = Enum.SortOrder.LayoutOrder;
    ddLayout.Parent    = bodyFrame;

    if not noCallbackOnStart then
        callback(config[title] and config[title] or list[1]);
        if config[title] then
            popup:new("Set " .. title .. " to " .. config[title]);
        end;
    end;

    self:initBtnEffect(btn);

    local arrowTween  = tweenService:Create(arrowLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation = 0});
    local arrowTween1 = tweenService:Create(arrowLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation = 180});

    local function refresh(lst)
        for _, v in next, bodyFrame:GetChildren() do
            if not v:IsA("UIListLayout") then v:Destroy(); end;
        end;
        for _, v in next, lst do
            local opt = Instance.new("TextButton");
            opt.BackgroundColor3      = fromRGB(45, 45, 45);
            opt.BackgroundTransparency = 1;
            opt.BorderSizePixel       = 0;
            opt.Size                  = newUDim2(1, 0, 0, 27);
            opt.Font                  = Enum.Font.Gotham;
            opt.TextSize              = 12;
            opt.TextColor3            = fromRGB(220, 220, 220);
            opt.Text                  = v;
            opt.ZIndex                = 6;
            opt.Parent                = bodyFrame;

            local hIn  = tweenService:Create(opt, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.5});
            local hOut = tweenService:Create(opt, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1});
            opt.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then hIn:Play(); end;
            end);
            opt.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then hOut:Play(); end;
            end);

            local closeTween = tweenService:Create(arrowLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation = 180});
            opt.MouseButton1Click:Connect(function()
                config[title] = v; saveConfig();
                callback(v);
                popup:new("Set " .. title .. " to " .. v);
                closeTween:Play();
                bodyFrame:TweenSize(newUDim2(0, 170, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true);
                wait(0.15);
                bodyFrame.Visible = false;
                self.bodyFrame.CanvasSize = oldSize;
            end);
            opt.TouchTap:Connect(function() opt.MouseButton1Click:Fire(); end);
        end;
    end;

    refresh(list);

    btn.MouseButton1Click:Connect(function()
        if not bodyFrame.Visible then
            oldSize = self.bodyFrame.CanvasSize;
            self.bodyFrame.CanvasSize = oldSize + newUDim2(0, 0, 0, 170);
            bodyFrame.Visible = true;
            arrowTween:Play();
            bodyFrame:TweenSize(newUDim2(0, 170, 0, (#bodyFrame:GetChildren() - 1) * 27), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true);
        elseif bodyFrame.Visible then
            arrowTween1:Play();
            bodyFrame:TweenSize(newUDim2(0, 170, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true);
            wait(0.15);
            bodyFrame.Visible = false;
            self.bodyFrame.CanvasSize = oldSize;
        end;
    end);

    btn.TouchTap:Connect(function() btn.MouseButton1Click:Fire(); end);

    return {
        Refresh = function(_, newList)
            list = newList;
            refresh(newList);
        end;
    };
end;

return AxewareLib;


