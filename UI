        mainFrame:TweenSize(newUDim2(0, 387, 0, 225), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.25, true);
    end;
end);

inputService.InputBegan:Connect(function(input, onGui)
    if not onGui and (input.KeyCode == Enum.KeyCode.P or input.KeyCode == Enum.KeyCode.RightShift) then
        owlLibGui.Enabled = not owlLibGui.Enabled;
    end;
end);

-- ── Shared helpers — exact copies ─────────────────────────────────────────────
function AxewareLib:SetCategory() end;

-- Original Resize: CanvasSize = (children - 1) * 36
-- We subtract UIListLayout from child count, same as original subtracting 1
function AxewareLib.Content:Resize(scrollingFrame)
    local count = 0;
    for _, v in next, scrollingFrame:GetChildren() do
        if not v:IsA("UIListLayout") then count = count + 1; end;
    end;
    scrollingFrame.CanvasSize = newUDim2(0, 0, 0, count * 36);
end;

-- Original initBtnEffect: hover fades BackgroundTransparency 0.85 ↔ 1
function AxewareLib.Content:initBtnEffect(btn)
    local btnHover  = tweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.85});
    local btnHover1 = tweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1});
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then btnHover:Play(); end;
    end);
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then btnHover1:Play(); end;
    end);
end;

-- ── AxewareLib:new(title) ─────────────────────────────────────────────────────
-- Original: loads rbxassetid://4531111462 for bodyFrame (ScrollingFrame, dark bg, sits at y=54)
--           loads rbxassetid://4530456835 for tabBtn (ImageButton sized to text + 20)
--           active tab = ImageColor3 fromRGB(30,30,30), inactive = fromRGB(50,50,50)
function AxewareLib:new(title)
    local self = setmetatable({}, {__index = AxewareLib.Content});

    -- bodyFrame: ScrollingFrame, full width, fills remaining height below both bars
    local bodyFrame = Instance.new("ScrollingFrame");
    bodyFrame.Name             = title .. "BodyFrame";
    bodyFrame.BackgroundColor3 = fromRGB(40, 40, 40);
    bodyFrame.BorderSizePixel  = 0;
    bodyFrame.Position         = newUDim2(0, 0, 0, 54);
    bodyFrame.Size             = newUDim2(1, 0, 1, -54);
    bodyFrame.CanvasSize       = newUDim2(0, 0, 0, 0);
    bodyFrame.ScrollBarThickness     = 4;
    bodyFrame.ScrollBarImageColor3   = fromRGB(80, 80, 80);
    bodyFrame.Visible          = false;
    bodyFrame.Parent           = mainFrame;

    local listLayout = Instance.new("UIListLayout");
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder;
    listLayout.Parent    = bodyFrame;

    self.bodyFrame = bodyFrame;

    -- tabBtn: original is ImageButton sized to tabLabel.TextBounds.X + 20
    -- We use TextButton; ImageColor3 logic → BackgroundColor3
    local tabBtn = Instance.new("TextButton");
    tabBtn.Name                 = title .. "TabBtn";
    tabBtn.BackgroundColor3     = fromRGB(50, 50, 50);  -- inactive color
    tabBtn.BorderSizePixel      = 0;
    tabBtn.AutomaticSize        = Enum.AutomaticSize.X;
    tabBtn.Size                 = newUDim2(0, 0, 1, 0);
    tabBtn.Font                 = Enum.Font.GothamBold;
    tabBtn.TextSize             = 11;
    tabBtn.TextColor3           = fromRGB(180, 180, 180);
    tabBtn.Text                 = string.upper(title);
    tabBtn.Parent               = tabsFrame;

    -- Padding matches original tabLabel.TextBounds.X + 20 sizing (10px each side)
    local tpad = Instance.new("UIPadding");
    tpad.PaddingLeft  = UDim.new(0, 10);
    tpad.PaddingRight = UDim.new(0, 10);
    tpad.Parent       = tabBtn;

    if not firstBodyFrame then
        firstBodyFrame         = bodyFrame;
        bodyFrame.Visible      = true;
        tabBtn.BackgroundColor3 = fromRGB(30, 30, 30);  -- active color matches original
        tabBtn.TextColor3       = fromRGB(255, 255, 255);
    end;

    tabBtn.MouseButton1Click:Connect(function()
        -- Exact original logic: hide all BodyFrames, reset all tab colors
        for _, v in next, mainFrame:GetChildren() do
            if v.Name:find("BodyFrame") then
                if v ~= bodyFrame then v.Visible = false; end;
            end;
        end;
        for _, v in next, tabsFrame:GetChildren() do
            if v:IsA("TextButton") then
                v.BackgroundColor3 = fromRGB(50, 50, 50);
                v.TextColor3       = fromRGB(180, 180, 180);
            end;
        end;
        tabBtn.BackgroundColor3 = fromRGB(30, 30, 30);
        tabBtn.TextColor3       = fromRGB(255, 255, 255);
        bodyFrame.Visible       = true;
    end);

    -- Mobile: TouchTap fires the same click
    tabBtn.TouchTap:Connect(function()
        tabBtn.MouseButton1Click:Fire();
    end);

    return self;
end;

-- ── newBtn ────────────────────────────────────────────────────────────────────
-- Original toggle btn (rbxassetid://4531129509):
--   30px tall, width = titleLabel.TextBounds.X + 50
--   has .statusFrame (small colored square, left side)
--   has .titleLabel (text, right of status)
--   BackgroundTransparency = 1, hover fades to 0.85
--
-- Original action btn (rbxassetid://4531209476):
--   30px tall, width = titleLabel.TextBounds.X + 17
--   no statusFrame, just titleLabel
function AxewareLib.Content:newBtn(title, callback, noToggle)
    self:Resize(self.bodyFrame);

    if not noToggle then
        local enabled = config[title] and true or false;
        if enabled then
            callback(enabled);
            popup:new("Enabled " .. title);
        end;

        -- btn: full-width row, 30px tall, transparent bg (hover tween to 0.85)
        -- Original sized to text width but in practice these fill the frame scrolled
        local btn = Instance.new("TextButton");
        btn.Name                  = title .. "Btn";
        btn.BackgroundColor3      = fromRGB(50, 50, 50);
        btn.BackgroundTransparency = 1;
        btn.BorderSizePixel       = 0;
        btn.Size                  = newUDim2(1, 0, 0, 30);
        btn.Font                  = Enum.Font.Gotham;
        btn.TextSize              = 1;
        btn.Text                  = "";
        btn.Parent                = self.bodyFrame;

        -- statusFrame: small square, left side — green=on, red=off
        -- Original: Frame named statusFrame inside the asset btn
        local statusFrame = Instance.new("Frame");
        statusFrame.Name             = "statusFrame";
        statusFrame.BackgroundColor3 = enabled and fromRGB(0, 194, 94) or fromRGB(180, 0, 0);
        statusFrame.BorderSizePixel  = 0;
        statusFrame.Size             = newUDim2(0, 10, 0, 10);
        statusFrame.Position         = newUDim2(0, 8, 0.5, -5);
        statusFrame.Parent           = btn;

        -- titleLabel: text right of statusFrame
        local titleLabel = Instance.new("TextLabel");
        titleLabel.Name                = "titleLabel";
        titleLabel.BackgroundTransparency = 1;
        titleLabel.Position            = newUDim2(0, 24, 0, 0);
        titleLabel.Size                = newUDim2(1, -24, 1, 0);
        titleLabel.Font                = Enum.Font.Gotham;
        titleLabel.TextSize            = 13;
        titleLabel.TextColor3          = fromRGB(255, 255, 255);
        titleLabel.TextXAlignment      = Enum.TextXAlignment.Left;
        titleLabel.Text                = title;
        titleLabel.Parent              = btn;

        local toggle = {[true] = fromRGB(0, 194, 94), [false] = fromRGB(180, 0, 0)};

        tweenService:Create(statusFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {BackgroundColor3 = toggle[enabled]}):Play();

        self:initBtnEffect(btn);

        btn.MouseButton1Click:Connect(function()
            enabled = not enabled;
            config[title] = enabled;
            saveConfig();
            tweenService:Create(statusFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {BackgroundColor3 = toggle[enabled]}):Play();
            callback(enabled);
            popup:new((enabled and "Enabled " or "Disabled ") .. title);
        end);

        btn.TouchTap:Connect(function() btn.MouseButton1Click:Fire(); end);

        return {
            Set = function(_, bool)
                enabled = bool;
                config[title] = enabled;
                saveConfig();
                tweenService:Create(statusFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    {BackgroundColor3 = toggle[enabled]}):Play();
                callback(enabled);
                popup:new((enabled and "Enabled " or "Disabled ") .. title);
            end;
        };

    else
        -- noToggle action button — no statusFrame
        local btn = Instance.new("TextButton");
        btn.Name                  = title .. "Btn";
        btn.BackgroundColor3      = fromRGB(50, 50, 50);
        btn.BackgroundTransparency = 1;
        btn.BorderSizePixel       = 0;
        btn.Size                  = newUDim2(1, 0, 0, 30);
        btn.Font                  = Enum.Font.Gotham;
        btn.TextSize              = 1;
        btn.Text                  = "";
        btn.Parent                = self.bodyFrame;

        local titleLabel = Instance.new("TextLabel");
        titleLabel.Name                = "titleLabel";
        titleLabel.BackgroundTransparency = 1;
        titleLabel.Position            = newUDim2(0, 8, 0, 0);
        titleLabel.Size                = newUDim2(1, -8, 1, 0);
        titleLabel.Font                = Enum.Font.Gotham;
        titleLabel.TextSize            = 13;
        titleLabel.TextColor3          = fromRGB(255, 255, 255);
        titleLabel.TextXAlignment      = Enum.TextXAlignment.Left;
        titleLabel.Text                = title;
        titleLabel.Parent              = btn;

        self:initBtnEffect(btn);

        btn.MouseButton1Click:Connect(function()
            callback();
            popup:new("Enabled " .. title);
        end);

        btn.TouchTap:Connect(function() btn.MouseButton1Click:Fire(); end);

        return {
            Fire = function(_)
                callback();
                popup:new("Enabled " .. title);
            end;
        };
    end;
end;

-- ── newSlider ─────────────────────────────────────────────────────────────────
-- Original (rbxassetid://4531326550):
--   30px tall, width = titleLabel.TextBounds.X + 195
--   has .titleLabel on left
--   has .sliderIndicatorFrame (the track) — contains:
--       .valueLabel (italic, right side of track)
--       .slidingFrame (the fill, child of sliderIndicatorFrame)
--   slide() reads input.Position.X relative to sliderIndicatorFrame
function AxewareLib.Content:newSlider(title, callback, min, max, startPoint)
    self:Resize(self.bodyFrame);

    local dragging = false;

    -- Outer row (matches original sliderFrame)
    local sliderFrame = Instance.new("Frame");
    sliderFrame.Name             = title .. "Slider";
    sliderFrame.BackgroundTransparency = 1;
    sliderFrame.BorderSizePixel  = 0;
    sliderFrame.Size             = newUDim2(1, 0, 0, 30);
    sliderFrame.Parent           = self.bodyFrame;

    -- titleLabel: left side, same font/size as btn titleLabel
    local titleLabel = Instance.new("TextLabel");
    titleLabel.Name               = "titleLabel";
    titleLabel.BackgroundTransparency = 1;
    titleLabel.Position           = newUDim2(0, 8, 0, 0);
    titleLabel.Size               = newUDim2(0, 100, 1, 0);
    titleLabel.Font               = Enum.Font.Gotham;
    titleLabel.TextSize           = 13;
    titleLabel.TextColor3         = fromRGB(255, 255, 255);
    titleLabel.TextXAlignment     = Enum.TextXAlignment.Left;
    titleLabel.Text               = title;
    titleLabel.Parent             = sliderFrame;

    -- sliderIndicatorFrame: the dark track, sits right of title
    -- Original width fills to right edge; we mirror the +195 sizing
    local sliderIndicatorFrame = Instance.new("Frame");
    sliderIndicatorFrame.Name             = "sliderIndicatorFrame";
    sliderIndicatorFrame.BackgroundColor3 = fromRGB(50, 50, 50);
    sliderIndicatorFrame.BorderSizePixel  = 0;
    sliderIndicatorFrame.Position         = newUDim2(0, 112, 0.5, -5);
    sliderIndicatorFrame.Size             = newUDim2(1, -160, 0, 10);
    sliderIndicatorFrame.Parent           = sliderFrame;

    -- slidingFrame: the lighter fill inside the track
    local slidingFrame = Instance.new("Frame");
    slidingFrame.Name             = "slidingFrame";
    slidingFrame.BackgroundColor3 = fromRGB(100, 100, 100);
    slidingFrame.BorderSizePixel  = 0;
    slidingFrame.Size             = newUDim2(0, 0, 1, 0);
    slidingFrame.Parent           = sliderIndicatorFrame;

    -- valueLabel: italic grey, right of the track
    -- Original: inside sliderIndicatorFrame, shown as italic number
    local valueLabel = Instance.new("TextLabel");
    valueLabel.Name               = "valueLabel";
    valueLabel.BackgroundTransparency = 1;
    valueLabel.Position           = newUDim2(1, 6, 0, 0);
    valueLabel.Size               = newUDim2(0, 36, 1, 0);
    valueLabel.Font               = Enum.Font.GothamItalic;
    valueLabel.TextSize           = 12;
    valueLabel.TextColor3         = fromRGB(150, 150, 150);
    valueLabel.TextXAlignment     = Enum.TextXAlignment.Left;
    valueLabel.Text               = "0";
    valueLabel.Parent             = sliderFrame;  -- parented to row so it sits right of track

    -- Reposition valueLabel relative to sliderIndicatorFrame right edge
    -- We handle this by parenting to sliderIndicatorFrame instead:
    valueLabel.Parent   = sliderIndicatorFrame;
    valueLabel.Position = newUDim2(1, 4, 0, 0);
    valueLabel.Size     = newUDim2(0, 36, 1, 0);

    local sp = config[title] and tonumber(config[title]) or startPoint;

    -- Exact original formula: floor((startPoint / max) * (max - min) + min)
    local function computeDisplay(scale)
        return floor((scale * max / max) * (max - min) + min);
    end;

    if sp then
        local initScale = clamp(sp / max, 0, 1);
        slidingFrame.Size = newUDim2(initScale, 0, 1, 0);
        valueLabel.Text   = tostring(computeDisplay(initScale));
        callback(computeDisplay(initScale));
        if config[title] then
            popup:new("Set " .. title .. " to " .. tostring(computeDisplay(initScale)));
        end;
    end;

    -- slide() — exact copy of original
    local function slide(input)
        local pos = newUDim2(clamp(
            (input.Position.X - sliderIndicatorFrame.AbsolutePosition.X) / sliderIndicatorFrame.AbsoluteSize.X,
            0, 1), 0, 1, 0);
        slidingFrame:TweenSize(pos, Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true);
        local value = floor(((pos.X.Scale * max) / max) * (max - min) + min);
        valueLabel.Text = tostring(value);
        callback(value);
    end;

    sliderIndicatorFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            slide(input);
            dragging = true;
        end;
    end);
    sliderIndicatorFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false;
            config[title] = valueLabel.Text;
            saveConfig();
            popup:new("Set " .. title .. " to " .. valueLabel.Text);
        end;
    end);
    inputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            slide(input);
        end;
    end);
end;

-- ── newTextbox ────────────────────────────────────────────────────────────────
-- Original (rbxassetid://4531463561):
--   30px tall, width = titleLabel.TextBounds.X + 100
--   .titleLabel on left
