-- ─────────────────────────────────────────────────────────────────────────────
-- DRAGGING  — FIX: use RenderStepped for buttery-smooth movement.
--             Drag is initiated from topBar OR tabsFrame (both header areas).
--             Stores cursor-to-frame-corner offset at mousedown so the grabbed
--             pixel stays locked under the cursor with zero accumulated error.
-- ─────────────────────────────────────────────────────────────────────────────
local dragging = false
local dragOffX = 0
local dragOffY = 0

local function beginDrag(input)
    dragging = true
    dragOffX = input.Position.X - mainFrame.AbsolutePosition.X
    dragOffY = input.Position.Y - mainFrame.AbsolutePosition.Y
end

local function endDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end

local function attachDrag(frame)
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            beginDrag(input)
        end
    end)
    frame.InputEnded:Connect(endDrag)
end

attachDrag(topBar)
attachDrag(tabsFrame)

-- Global mouse move: fires every pixel of movement, offset math means zero drift
inputSvc.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then return end
    mainFrame.Position = ud2(0, input.Position.X - dragOffX, 0, input.Position.Y - dragOffY)
end)

-- Safety release in case mouse button is released outside a frame
inputSvc.InputEnded:Connect(endDrag)

