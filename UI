    b.Text                       = symbol
    b.Parent                     = topBar

    local tIn  = tweenSvc:Create(b, TweenInfo.new(0.2), { TextTransparency = 0   })
    local tOut = tweenSvc:Create(b, TweenInfo.new(0.2), { TextTransparency = 0.2 })
    b.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement then tIn:Play() end
    end)
    b.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement then tOut:Play() end
    end)
    return b
end

