-- AxewareLib.lua
-- Asset-free, mobile-friendly Roblox UI Library
-- Elements: Tabs, Buttons (Toggle), Action Buttons, Textbox, Label

local AxewareLib = {Content = {}};
local config = {};

local placeID = tostring(game.PlaceId);
local httpService = game:GetService("HttpService");

pcall(function()
    config = httpService:JSONDecode(readfile(placeID .. "_axeware.txt"));
end);

local function saveConfig()
    writefile(placeID .. "_axeware.txt", httpService:JSONEncode(config));
end;

