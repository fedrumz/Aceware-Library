    titleLbl.BackgroundTransparency    = 1
    titleLbl.Position                  = ud2(0, 10, 0, 0)
    titleLbl.Size                      = ud2(0, 110, 1, 0)
    titleLbl.Font                      = Enum.Font.Gotham
    titleLbl.TextSize                  = 14
    titleLbl.TextColor3                = C.textMain
    titleLbl.TextXAlignment            = Enum.TextXAlignment.Left
    titleLbl.Text                      = title
    titleLbl.Parent                    = row

    -- Dark container Frame on the right — mirrors the working lib's Frame wrapper
    local inputFrame                   = Instance.new("Frame")
    inputFrame.BackgroundColor3        = fromRGB(45, 45, 45)
    inputFrame.BorderSizePixel         = 0
    inputFrame.Position                = ud2(0, 122, 0.5, -10)
    inputFrame.Size                    = ud2(1, -130, 0, 20)
    inputFrame.Parent                  = row

    -- TextBox inside the Frame with BackgroundTransparency = 1, exactly like the working lib
    local box                          = Instance.new("TextBox")
    box.BackgroundTransparency         = 1
    box.BorderSizePixel                = 0
    box.Size                           = ud2(1, -6, 1, 0)
    box.Position                       = ud2(0, 4, 0, 0)
    box.Font                           = Enum.Font.Gotham
    box.TextSize                       = 12
    box.TextColor3                     = C.textGrey
    box.PlaceholderColor3              = C.textDim
    box.PlaceholderText                = "..."
    box.TextXAlignment                 = Enum.TextXAlignment.Left
    box.ClearTextOnFocus               = false
    box.Text                           = ""
    box.Parent                         = inputFrame

    local preset = (config[title] and config[title]) or (presetText or "")
    if config[title] then popup:new("Set " .. title .. " to " .. config[title]) end
    box.Text = preset
    if not noCallbackOnStart then callback(preset) end

    -- Exactly how the working lib does it: Focused/FocusLost on the TextBox
    box.Focused:Connect(function()
        tweenSvc:Create(inputFrame, TweenInfo.new(0.2), { BackgroundColor3 = fromRGB(65, 65, 65) }):Play()
    end)

    box.FocusLost:Connect(function(enterPressed)
        tweenSvc:Create(inputFrame, TweenInfo.new(0.2), { BackgroundColor3 = fromRGB(45, 45, 45) }):Play()
        config[title] = box.Text
        saveConfig()
        callback(box.Text)
        popup:new("Set " .. title .. " to " .. box.Text)
    end)
end

-- ─────────────────────────────────────────────────────────────────────────────
-- newBind  (toggle on/off each press)
-- FIX: row height 30→36
-- ─────────────────────────────────────────────────────────────────────────────
function AxewareLib.Content:newBind(title, callback, presetKeyCode)
    local enabled   = false
    local listening = false
    presetKeyCode   = config[title] and Enum.KeyCode[config[title]] or presetKeyCode
    local activated = presetKeyCode ~= nil
    local keyCode   = presetKeyCode

    local row                          = Instance.new("Frame")
    row.Name                           = title .. "Bind"
    row.BackgroundTransparency         = 1
    row.BorderSizePixel                = 0
    row.Size                           = ud2(1, 0, 0, 36)    -- FIX: 30 → 36
    row.Parent                         = self.bodyFrame
    

    local titleLbl                     = Instance.new("TextLabel")
    titleLbl.BackgroundTransparency    = 1
    titleLbl.Position                  = ud2(0, 10, 0, 0)
    titleLbl.Size                      = ud2(1, -80, 1, 0)
    titleLbl.Font                      = Enum.Font.Gotham
    titleLbl.TextSize                  = 14    -- FIX: 13 → 14
    titleLbl.TextColor3                = C.textMain
    titleLbl.TextXAlignment            = Enum.TextXAlignment.Left
    titleLbl.Text                      = title
    titleLbl.Parent                    = row

    local bindBtn                      = Instance.new("TextButton")
    bindBtn.Name                       = "bindBtn"
    bindBtn.BackgroundColor3           = C.bind
    bindBtn.BorderSizePixel            = 0
    bindBtn.Size                       = ud2off(60, 18)
    bindBtn.Position                   = ud2(1, -68, 0.5, -9)
    bindBtn.Font                       = Enum.Font.GothamBold
    bindBtn.TextSize                   = 10
    bindBtn.TextColor3                 = C.textGrey
    bindBtn.Text                       = presetKeyCode
        and string.upper(tostring(string.char(presetKeyCode.Value)))
        or "KEY"
    bindBtn.Parent                     = row

    if config[title] then popup:new("Set " .. title .. " to " .. bindBtn.Text) end

    inputSvc.InputBegan:Connect(function(input, onGui)
        if onGui then return end
        if listening and not activated then
            pcall(function()
                bindBtn.Text  = string.upper(tostring(string.char(input.KeyCode.Value)))
                listening     = false
                config[title] = input.KeyCode.Name
                saveConfig()
                keyCode   = input.KeyCode
                activated = true
                popup:new("Set " .. title .. " to " .. bindBtn.Text)
            end)
        elseif activated and not listening and input.KeyCode == keyCode then
            enabled = not enabled
            callback(enabled)
        end
    end)

    bindBtn.MouseButton1Click:Connect(function()
        bindBtn.Text = "..."
        activated    = false
        listening    = true
    end)
end

-- ─────────────────────────────────────────────────────────────────────────────
-- newCBind  (hold bind: true while key held, false on release)
-- FIX: row height 30→36
-- ─────────────────────────────────────────────────────────────────────────────
function AxewareLib.Content:newCBind(title, callback, presetKeyCode)
    local shortNames = {
        RightControl = "RightCtrl"; LeftControl = "LeftCtrl";
        LeftShift    = "LShift";    RightShift  = "RShift";
        MouseButton1 = "Mouse1";    MouseButton2 = "Mouse2";
    }

    presetKeyCode = presetKeyCode or nil
    if config[title] then
        local kb = config[title]:find("Keyboard")
        presetKeyCode = kb
            and Enum.KeyCode[config[title]:gsub("Keyboard", "")]
            or  Enum.UserInputType[config[title]]
        popup:new("Set " .. title .. " to " ..
            (shortNames[presetKeyCode.Name] or presetKeyCode.Name))
    end

    local activated = presetKeyCode ~= nil
    local keyCode   = presetKeyCode
    local nm        = presetKeyCode
        and (shortNames[presetKeyCode.Name] or presetKeyCode.Name)
        or  "None"

    local row                          = Instance.new("Frame")
    row.Name                           = title .. "CBind"
    row.BackgroundTransparency         = 1
    row.BorderSizePixel                = 0
    row.Size                           = ud2(1, 0, 0, 36)    -- FIX: 30 → 36
    row.Parent                         = self.bodyFrame
    

    local titleLbl                     = Instance.new("TextLabel")
    titleLbl.BackgroundTransparency    = 1
    titleLbl.Position                  = ud2(0, 10, 0, 0)
    titleLbl.Size                      = ud2(1, -80, 1, 0)
    titleLbl.Font                      = Enum.Font.Gotham
    titleLbl.TextSize                  = 14    -- FIX: 13 → 14
    titleLbl.TextColor3                = C.textMain
    titleLbl.TextXAlignment            = Enum.TextXAlignment.Left
    titleLbl.Text                      = title
    titleLbl.Parent                    = row

    local bindBtn                      = Instance.new("TextButton")
    bindBtn.BackgroundColor3           = C.bind
    bindBtn.BorderSizePixel            = 0
    bindBtn.Size                       = ud2off(60, 18)
    bindBtn.Position                   = ud2(1, -68, 0.5, -9)
    bindBtn.Font                       = Enum.Font.GothamBold
    bindBtn.TextSize                   = 10
    bindBtn.TextColor3                 = C.textGrey
    bindBtn.Text                       = nm
    bindBtn.Parent                     = row

    local function isPressed(bind, inp)
        if typeof(bind) == "Instance" then
            if bind.UserInputType == Enum.UserInputType.Keyboard
            and inp.KeyCode == bind.KeyCode then return true end
            if tostring(bind.UserInputType):find("MouseButton")
            and inp.UserInputType == bind.UserInputType then return true end
        end
        if tostring(bind):find("MouseButton") then
            return bind == inp.UserInputType
        end
        return bind == inp.KeyCode
    end

    inputSvc.InputBegan:Connect(function(input, onGui)
        if onGui then return end
        if activated and isPressed(keyCode, input) then callback(true) end
    end)
    inputSvc.InputEnded:Connect(function(input, onGui)
        if onGui then return end
        if activated and isPressed(keyCode, input) then callback(false) end
    end)

    bindBtn.MouseButton1Click:Connect(function()
        bindBtn.Text = "..."
        activated    = false
        local input  = inputSvc.InputBegan:Wait()
        config[title] = (input.UserInputType ~= Enum.UserInputType.Keyboard
            and input.UserInputType.Name
            or  input.KeyCode.Name .. "Keyboard")
        saveConfig()
        keyCode = input
        local name = (input.UserInputType ~= Enum.UserInputType.Keyboard
            and (shortNames[input.UserInputType.Name] or input.UserInputType.Name)
            or   input.KeyCode.Name)
        bindBtn.Text = name
        activated    = true
        popup:new("Set " .. title .. " to " .. name)
    end)
end

