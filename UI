-- AxewareLib:new(title)
-- ─────────────────────────────────────────────────────────────────────────────
local firstBodyFrame
function AxewareLib:new(title)
    local self = setmetatable({}, { __index = AxewareLib.Content })

    local body                     = Instance.new("Frame")
    body.Name                      = title .. "BodyFrame"
    body.BackgroundColor3          = C.body
    body.BorderSizePixel           = 0
    body.Position                  = ud2(0, 0, 0, 54)
    body.Size                      = ud2(1, 0, 1, -54)
    body.Visible                   = false
    body.Parent                    = mainFrame

    local ll                       = Instance.new("UIListLayout")
    ll.SortOrder                   = Enum.SortOrder.LayoutOrder
    ll.Parent                      = body

    self.bodyFrame = body

    local tab                      = Instance.new("TextButton")
    tab.Name                       = title .. "TabBtn"
    tab.BackgroundColor3           = C.tab
    tab.BorderSizePixel            = 0
    tab.AutomaticSize              = Enum.AutomaticSize.X
    tab.Size                       = ud2(0, 0, 1, 0)
    tab.Font                       = Enum.Font.GothamBold
    tab.TextSize                   = 11
    tab.TextColor3                 = C.textGrey
    tab.Text                       = string.upper(title)
    tab.Parent                     = tabsFrame

    local pad                      = Instance.new("UIPadding")
    pad.PaddingLeft                = UDim.new(0, 12)
    pad.PaddingRight               = UDim.new(0, 12)
    pad.Parent                     = tab

    if not firstBodyFrame then
        firstBodyFrame       = body
        body.Visible         = true
        tab.BackgroundColor3 = C.tabActive
        tab.TextColor3       = C.white
    end

    tab.MouseButton1Click:Connect(function()
        for _, v in next, mainFrame:GetChildren() do
            if v.Name:find("BodyFrame") and v ~= body then
                v.Visible = false
            end
        end
        for _, v in next, tabsFrame:GetChildren() do
            if v:IsA("TextButton") then
                v.BackgroundColor3 = C.tab
                v.TextColor3       = C.textGrey
            end
        end
        tab.BackgroundColor3 = C.tabActive
        tab.TextColor3       = C.white
        body.Visible         = true
    end)

    tab.TouchTap:Connect(function() tab.MouseButton1Click:Fire() end)

    return self
end

-- ─────────────────────────────────────────────────────────────────────────────
-- newBtn  (toggle or action)
-- FIX: row height 30→36, dot 12→15, font 13→14
-- ─────────────────────────────────────────────────────────────────────────────
function AxewareLib.Content:newBtn(title, callback, noToggle)
    local function makeRow()
        local btn                      = Instance.new("TextButton")
        btn.BackgroundColor3           = C.white
        btn.BackgroundTransparency     = 1
        btn.BorderSizePixel            = 0
        btn.Size                       = ud2(1, 0, 0, 36)   -- FIX: 30 → 36
        btn.Font                       = Enum.Font.Gotham
        btn.TextSize                   = 1
        btn.Text                       = ""
        btn.Parent                     = self.bodyFrame
        
        return btn
    end

    local function makeLabel(parent, xPos, xSize, text)
        local lbl                      = Instance.new("TextLabel")
        lbl.BackgroundTransparency     = 1
        lbl.Position                   = ud2(0, xPos, 0, 0)
        lbl.Size                       = ud2(1, xSize, 1, 0)
        lbl.Font                       = Enum.Font.Gotham
        lbl.TextSize                   = 14   -- FIX: 13 → 14
        lbl.TextColor3                 = C.textMain
        lbl.TextXAlignment             = Enum.TextXAlignment.Left
        lbl.Text                       = text
        lbl.Parent                     = parent
        return lbl
    end

    if not noToggle then
        local enabled = config[title] and true or false
        if enabled then callback(enabled); popup:new("Enabled " .. title) end

        local btn = makeRow()

        local dot                      = Instance.new("Frame")
        dot.Name                       = "statusFrame"
        dot.BorderSizePixel            = 0
        dot.Size                       = ud2off(15, 15)      -- FIX: 12 → 15
        dot.Position                   = ud2(0, 10, 0.5, -7) -- FIX: -6 → -7 (center 15px)
        dot.BackgroundColor3           = enabled and C.green or C.red
        dot.Parent                     = btn

        makeLabel(btn, 32, -40, title)  -- FIX: xPos 28→32, xSize -36→-40
        self:initBtnEffect(btn)

        local colorMap = { [true] = C.green, [false] = C.red }
        local function setEnabled(val)
            enabled = val
            config[title] = val
            saveConfig()
            tweenSvc:Create(dot, TweenInfo.new(0.25), { BackgroundColor3 = colorMap[val] }):Play()
            callback(val)
            popup:new((val and "Enabled " or "Disabled ") .. title)
        end

        btn.MouseButton1Click:Connect(function() setEnabled(not enabled) end)
        btn.TouchTap:Connect(function() btn.MouseButton1Click:Fire() end)

        return {
            Set = function(_, bool) setEnabled(bool) end
        }

    else
        local btn = makeRow()
        makeLabel(btn, 10, -18, title)
        self:initBtnEffect(btn)

        btn.MouseButton1Click:Connect(function()
            callback()
            popup:new("Fired " .. title)
        end)
        btn.TouchTap:Connect(function() btn.MouseButton1Click:Fire() end)

        return {
            Fire = function(_) callback(); popup:new("Fired " .. title) end
        }
    end
end

