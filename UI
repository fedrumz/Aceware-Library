-- ─────────────────────────────────────────────
-- AxewareLib:new(title)  →  Tab object
-- ─────────────────────────────────────────────
function AxewareLib:new(title)
    local self = setmetatable({}, {__index = AxewareLib.Content});

    -- Scrollable body for this tab
    local body = Instance.new("ScrollingFrame");
    body.Name = title .. "_Body";
    body.BackgroundTransparency = 1;
    body.BorderSizePixel = 0;
    body.Size = newUDim2(1, 0, 1, 0);
    body.CanvasSize = newUDim2(0, 0, 0, 0);
    body.ScrollBarThickness = 3;
    body.ScrollBarImageColor3 = C.ACCENT;
    body.Visible = false;
    body.Parent = contentArea;

    local layout = Instance.new("UIListLayout");
    layout.SortOrder = Enum.SortOrder.LayoutOrder;
    layout.Padding = UDim.new(0, 0);
    layout.Parent = body;

    local pad = Instance.new("UIPadding");
    pad.PaddingTop = UDim.new(0, 8);
    pad.PaddingBottom = UDim.new(0, 8);
    pad.Parent = body;

    layout.Changed:Connect(function()
        body.CanvasSize = newUDim2(0, 0, 0, layout.AbsoluteContentSize.Y + 16);
    end);

    self.bodyFrame = body;
    self._itemCount = 0;

    -- Tab button
    local tabBtn = Instance.new("TextButton");
    tabBtn.BackgroundTransparency = 1;
    tabBtn.Size = newUDim2(0, 0, 1, 0);
    tabBtn.AutomaticSize = Enum.AutomaticSize.X;
    tabBtn.Font = Enum.Font.GothamMedium;
    tabBtn.TextSize = 12;
    tabBtn.TextColor3 = C.SUBTEXT;
    tabBtn.Text = title;
    tabBtn.Parent = tabBar;

    local tabPad = Instance.new("UIPadding");
    tabPad.PaddingLeft = UDim.new(0, 10);
    tabPad.PaddingRight = UDim.new(0, 10);
    tabPad.Parent = tabBtn;

    local indicator = Instance.new("Frame");
    indicator.Name = "Indicator";
    indicator.BackgroundColor3 = C.ACCENT;
    indicator.BorderSizePixel = 0;
    indicator.Size = newUDim2(0, 0, 0, 2);
    indicator.Position = newUDim2(0.5, 0, 1, -2);
    indicator.AnchorPoint = Vector2.new(0.5, 0);
    indicator.Parent = tabBtn;

    local function activate()
        -- Hide all bodies
        for _, v in next, contentArea:GetChildren() do
            if v:IsA("ScrollingFrame") then v.Visible = false; end;
        end;
        -- Deactivate all tab btns
        for _, v in next, tabBar:GetChildren() do
            if v:IsA("TextButton") then
                tweenService:Create(v, TweenInfo.new(0.15), {TextColor3 = C.SUBTEXT}):Play();
                local ind = v:FindFirstChild("Indicator");
                if ind then tweenService:Create(ind, TweenInfo.new(0.15), {Size = newUDim2(0, 0, 0, 2)}):Play(); end;
            end;
        end;
        body.Visible = true;
        tweenService:Create(tabBtn, TweenInfo.new(0.15), {TextColor3 = C.TEXT}):Play();
        tweenService:Create(indicator, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = newUDim2(1, 0, 0, 2)}):Play();
    end;

    if firstTab then
        firstTab = false;
        activate();
    end;

    tabBtn.MouseButton1Click:Connect(activate);
    tabBtn.TouchTap:Connect(activate);

    return self;
end;

-- ─────────────────────────────────────────────
-- Shared row factory
-- ─────────────────────────────────────────────
local function makeRow(parent, height)
    height = height or 42;
    local row = Instance.new("Frame");
    row.BackgroundTransparency = 1;
    row.Size = newUDim2(1, 0, 0, height);
    row.BorderSizePixel = 0;
    row.Parent = parent;
    return row;
end;

